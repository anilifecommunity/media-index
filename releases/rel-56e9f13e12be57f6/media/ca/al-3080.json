le":100,"source":"anilist","value":58},"season":"SUMMER","seasonYear":2002,"series":["al-3080"],"seriesIds":[3080],"startDate":{"day":19,"month":8,"year":2002},"status":"FINISHED","studios":[{"animation":true,"id":6,"name":"GAINAX"},{"animation":false,"id":155,"name":"Animate"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"This is the Animation Store Manager!!\n\nAnime Tenchou is a CM character for Animate, one of Japan's biggest retailer of anime, games, and manga. The character series was created by Shimamoto Kazuhiko for publicity purposes. Later adapted into a manga, a weekly radio drama and this OVA animated by GAINAX and directed by Anno Hideaki.\n\nAnizawa Meito is the blazing store manager. He is a fireball who loves animation merchandise at heart. He takes over the dying wish of the former store manager, though still alive, who was attacked by the rival store and becomes a “store manager” of newly opened animation goods specialty store, Animate. The scarlet, “store manager visor” is his trademark.\n\n(Source: AniDB)"},"tags":[{"name":"Parody","rank":92,"spoiler":false},{"name":"Advertisement","rank":80,"spoiler":false},{"name":"Male Protagonist","rank":79,"spoiler":false},{"name":"Otaku Culture","rank":66,"spoiler":false},{"name":"Urban","rank":55,"spoiler":false},{"name":"Henshin","rank":50,"spoiler":false},{"name":"Work","rank":46,"spoiler":false},{"name":"Mixed Media","rank":20,"spoiler":false}],"titles":{"display":"Anime Tenchou","english":null,"native":"アニメ店長","romaji":"Anime Tenchou","synonyms":[]},"trailer":null,"visibility":"general"}