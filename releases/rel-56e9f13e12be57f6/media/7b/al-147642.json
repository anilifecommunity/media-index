"animation":false,"id":7481,"name":"NatsumeAtari"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Rentt Faina has hunted monsters for the last 10 years. Sadly, he’s not great at his job, stuck hunting slimes and goblins for a few coins each day. His luck turns when he finds an undiscovered path. At the path’s end, he meets his demise in the maw of a legendary dragon. But, he wakes up as an undead bag of bones! He sets out to achieve Existential Evolution and rejoin the land of the living.\n\n(Source: Crunchyroll)\n\nNote: Each episode streamed 3 days early on some streaming sites. The original TV broadcast started on January 8th, 2024."},"tags":[{"name":"Reincarnation","rank":91,"spoiler":true},{"name":"Dungeon","rank":88,"spoiler":false},{"name":"Magic","rank":88,"spoiler":false},{"name":"Swordplay","rank":86,"spoiler":false},{"name":"Monster Boy","rank":85,"spoiler":true},{"name":"Alchemy","rank":80,"spoiler":false},{"name":"Male Protagonist","rank":76,"spoiler":false},{"name":"Vampire","rank":74,"spoiler":true},{"name":"Skeleton","rank":73,"spoiler":true},{"name":"Found Family","rank":55,"spoiler":false},{"name":"Medieval","rank":53,"spoiler":false},{"name":"Tragedy","rank":52,"spoiler":true},{"name":"Time Skip","rank":50,"spoiler":true},{"name":"Zombie","rank":50,"spoiler":true},{"name":"CGI","rank":46,"spoiler":false}],"titles":{"display":"The Unwanted Undead Adventurer","english":"The Unwanted Undead Adventurer","native":"望まぬ不死の冒険者","romaji":"Nozomanu Fushi no Boukensha","synonyms":[{"language":"zh","source":"bangumi","value":"事与愿违的不死冒险者"},{"language":null,"source":"bangumi","value":"非自愿的不死冒险者"}]},"trailer":{"id":"zzbm_d03KqM","site":"youtube","thumbnail":"https://i.ytimg.com/vi/zzbm_d03KqM/hqdefault.jpg"},"visibility":"general"}