e hell hounds or high water, but they will defend their city!\n\n(Source: RightStuf)"},"tags":[{"name":"Shounen","rank":79,"spoiler":false},{"name":"Magic","rank":79,"spoiler":false},{"name":"Guns","rank":79,"spoiler":false},{"name":"Female Protagonist","rank":79,"spoiler":false},{"name":"Youkai","rank":75,"spoiler":false},{"name":"Nekomimi","rank":75,"spoiler":false},{"name":"Urban Fantasy","rank":73,"spoiler":false},{"name":"Kemonomimi","rank":72,"spoiler":false},{"name":"Super Power","rank":60,"spoiler":false},{"name":"Demons","rank":60,"spoiler":false},{"name":"Swordplay","rank":60,"spoiler":false}],"titles":{"display":"Yozakura Quartet","english":null,"native":"夜桜四重奏 ～ヨザクラカルテット～","romaji":"Yozakura Quartet","synonyms":[{"language":"ja","source":"bangumi","value":"夜桜四重奏 〜ヨザクラカルテット〜"},{"language":"zh","source":"bangumi","value":"夜樱四重奏"}]},"trailer":null,"visibility":"general"}