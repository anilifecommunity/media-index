ity and self-acceptance as a result of his experiences.\n\n(Source: Nippon Animation)"},"tags":[{"name":"Classic Literature","rank":90,"spoiler":false},{"name":"Historical","rank":88,"spoiler":false},{"name":"Foreign","rank":80,"spoiler":false},{"name":"Male Protagonist","rank":79,"spoiler":false},{"name":"Kids","rank":79,"spoiler":false},{"name":"Travel","rank":79,"spoiler":false},{"name":"Coming of Age","rank":60,"spoiler":false},{"name":"Tragedy","rank":35,"spoiler":true}],"titles":{"display":"3000 Leagues in Search of Mother","english":"3000 Leagues in Search of Mother","native":"母をたずねて三千里","romaji":"Haha wo Tazunete Sanzenri","synonyms":[{"language":"zh","source":"bangumi","value":"三千里寻母记"},{"language":null,"source":"bangumi","value":"寻母三千里"}]},"trailer":null,"visibility":"general"}