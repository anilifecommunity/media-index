ide to look into the matter. Little does Hiro know that this investigation will be their first step toward discovering a dangerous world previously unknown to mankind.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Artificial Intelligence","rank":90,"spoiler":false},{"name":"Youkai","rank":90,"spoiler":false},{"name":"Episodic","rank":87,"spoiler":false},{"name":"Body Horror","rank":85,"spoiler":true},{"name":"Kids","rank":84,"spoiler":false},{"name":"Primarily Child Cast","rank":82,"spoiler":false},{"name":"Urban Fantasy","rank":80,"spoiler":false},{"name":"Henshin","rank":80,"spoiler":false},{"name":"Ghost","rank":72,"spoiler":false},{"name":"Dinosaurs","rank":65,"spoiler":false},{"name":"Kaiju","rank":60,"spoiler":true},{"name":"Proxy Battle","rank":60,"spoiler":false},{"name":"Virtual World","rank":57,"spoiler":false},{"name":"Anthropomorphism","rank":55,"spoiler":false},{"name":"Zombie","rank":46,"spoiler":true},{"name":"Male Protagonist","rank":40,"spoiler":false},{"name":"Tragedy","rank":36,"spoiler":true},{"name":"Vampire","rank":35,"spoiler":true},{"name":"Slavery","rank":35,"spoiler":true},{"name":"Anti-Hero","rank":33,"spoiler":true},{"name":"Yandere","rank":33,"spoiler":true},{"name":"Suicide","rank":30,"spoiler":true},{"name":"Dullahan","rank":20,"spoiler":true},{"name":"Marriage","rank":10,"spoiler":false},{"name":"Isekai","rank":10,"spoiler":true}],"titles":{"display":"Digimon Ghost Game","english":"Digimon Ghost Game","native":"デジモンゴーストゲーム","romaji":"Digimon Ghost Game","synonyms":[{"language":"zh","source":"bangumi","value":"数码宝贝幽灵游戏"},{"language":null,"source":"bangumi","value":"数码兽幽灵游戏"},{"language":null,"source":"bangumi","value":"数码暴龙幽灵游戏"},{"language":null,"source":"bangumi","value":"Dejimon Gōsuto Gēmu"}]},"trailer":{"id":"tZNciGqbDao","site":"youtube","thumbnail":"https://i.ytimg.com/vi/tZNciGqbDao/hqdefault.jpg"},"visibility":"general"}