asa.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Ice Sports","rank":100,"spoiler":false},{"name":"Female Protagonist","rank":100,"spoiler":false},{"name":"Male Protagonist","rank":100,"spoiler":false},{"name":"Athletics","rank":96,"spoiler":false},{"name":"Seinen","rank":96,"spoiler":false},{"name":"Primarily Child Cast","rank":84,"spoiler":false},{"name":"Urban","rank":73,"spoiler":false},{"name":"Coming of Age","rank":66,"spoiler":false},{"name":"Dancing","rank":66,"spoiler":false},{"name":"CGI","rank":65,"spoiler":false},{"name":"Found Family","rank":60,"spoiler":false},{"name":"Rehabilitation","rank":50,"spoiler":false}],"titles":{"display":"Medalist Season 2","english":"Medalist Season 2","native":"メダリスト 第2期","romaji":"Medalist 2nd Season","synonyms":[{"language":"zh","source":"bangumi","value":"金牌得主 第二季"},{"language":null,"source":"bangumi","value":"舞冰的祈愿 第二季"}]},"trailer":{"id":"GTaqXo7scOY","site":"youtube","thumbnail":"https://i.ytimg.com/vi/GTaqXo7scOY/hqdefault.jpg"},"visibility":"general"}