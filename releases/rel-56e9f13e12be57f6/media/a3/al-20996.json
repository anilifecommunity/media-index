 as usual, nothing is ever that simple for the Yorozuya team.\n\nFilled with tongue-in-cheek humor and moments of heartfelt emotion, Gintama's fourth season finds Gintoki and his friends facing both their most hilarious misadventures and most dangerous crises yet.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Tragedy","rank":89,"spoiler":true},{"name":"Samurai","rank":88,"spoiler":false},{"name":"Meta","rank":88,"spoiler":false},{"name":"Swordplay","rank":88,"spoiler":false},{"name":"Male Protagonist","rank":86,"spoiler":false},{"name":"Found Family","rank":86,"spoiler":false},{"name":"Parody","rank":85,"spoiler":false},{"name":"Philosophy","rank":85,"spoiler":false},{"name":"Shounen","rank":82,"spoiler":false},{"name":"Politics","rank":81,"spoiler":false},{"name":"Conspiracy","rank":77,"spoiler":true},{"name":"Primarily Adult Cast","rank":76,"spoiler":false},{"name":"Gore","rank":74,"spoiler":true},{"name":"Aliens","rank":72,"spoiler":false},{"name":"Anachronism","rank":71,"spoiler":false},{"name":"Historical","rank":63,"spoiler":false},{"name":"Space","rank":58,"spoiler":false},{"name":"Ninja","rank":58,"spoiler":false},{"name":"Kuudere","rank":34,"spoiler":false},{"name":"Gender Bending","rank":28,"spoiler":true},{"name":"Body Swapping","rank":27,"spoiler":true},{"name":"Time Manipulation","rank":20,"spoiler":true},{"name":"Ensemble Cast","rank":20,"spoiler":false}],"titles":{"display":"Gintama Season 3","english":"Gintama Season 3","native":"銀魂゜","romaji":"Gintama°","synonyms":[{"language":"ja","source":"bangumi","value":"銀魂°"},{"language":"zh","source":"bangumi","value":"银魂°"},{"language":null,"source":"bangumi","value":"银魂 第3期"},{"language":null,"source":"bangumi","value":"銀魂 第3期"}]},"trailer":{"id":"yTh0f4PGL_8","site":"youtube","thumbnail":"https://i.ytimg.com/vi/yTh0f4PGL_8/hqdefault.jpg"},"visibility":"general"}