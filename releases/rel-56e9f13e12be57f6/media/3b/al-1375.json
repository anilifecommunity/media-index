990},"status":"FINISHED","studios":[{"animation":true,"id":22,"name":"Nippon Animation"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Daddy Long Legs is based on the novel of the same name by Jean Webster. It chronicles the adventures of Judy Abbott, an orphan in New York. During a meeting for the superintendent, with other important and rich people in attendance, a scholarship is offered to Judy by a mysterious benefactor. Catching only a glimpse of his tall shadow as he leaves, Judy calls him \"Daddy Long Legs\" and writes him letters every month as per his request. While studying at the Lincoln Memorial school, she makes many friends and learns about a world she never knew about before.\n\n(Source: Anime News Network)"},"tags":[{"name":"Classic Literature","rank":100,"spoiler":false},{"name":"Coming of Age","rank":79,"spoiler":false},{"name":"Foreign","rank":79,"spoiler":false},{"name":"Age Gap","rank":79,"spoiler":true},{"name":"Historical","rank":79,"spoiler":false},{"name":"Female Protagonist","rank":79,"spoiler":false},{"name":"Writing","rank":79,"spoiler":false},{"name":"Orphan","rank":60,"spoiler":false},{"name":"School","rank":50,"spoiler":false},{"name":"Bullying","rank":20,"spoiler":false},{"name":"Heterosexual","rank":20,"spoiler":true}],"titles":{"display":"My Daddy Long Legs","english":"My Daddy Long Legs","native":"私のあしながおじさん","romaji":"Watashi no Ashinaga Oji-san","synonyms":[{"language":"zh","source":"bangumi","value":"长腿叔叔"},{"language":null,"source":"bangumi","value":"我的长腿叔叔"}]},"trailer":null,"visibility":"general"}