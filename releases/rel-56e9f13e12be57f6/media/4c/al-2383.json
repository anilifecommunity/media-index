,"duration":24,"episodes":13,"format":"TV","genres":["Action","Mecha","Mystery","Psychological","Sci-Fi"],"id":567,"idMal":567,"isAdult":false,"popularity":29103,"season":"FALL","seasonYear":1999,"startDate":{"day":13,"month":10,"year":1999},"status":"FINISHED","title":{"english":"The Big O","native":"THEビッグオー","romaji":"THE Big O","userPreferred":"THE Big O"}},"ids":{"anilist":567},"mediaKey":"al-567","resolved":true}],"relations":[],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":68},"season":"FALL","seasonYear":1999,"series":["al-2383"],"seriesIds":[2383],"startDate":{"day":6,"month":9,"year":1999},"status":"FINISHED","studios":[{"animation":true,"id":65,"name":"Tokyo Movie Shinsha"},{"animation":true,"id":94,"name":"Telecom Animation Film"},{"animation":false,"id":467,"name":"Discotek"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"A genetically engineered soldier created by the sinister Von Richter, Cybersix now hides from her creator as she struggles to discover who she really is. By day, she poses as male high school teacher Adrian Seidelman, hiding the feelings she has for another teacher and avoiding the crush one of her students has on her secret identity.\n\nAt night, however, the city of Meridiana is anything but quiet. Setting aside her assumed identity, Cybersix must battle against her own kind; monstrous weapons created by Von Richter. The mad scientist plans to rule the world through terror, and the only thing standing in his way is his strongest \"failure\" and his greatest enemy: Cybersix. Who will prevail in this clash of creator and created? Can Cybersix live as a human and protect those she loves, or will she turn out to be nothing more than the very weapons she fights against?\n\n(Source: Discotek Media)"},"tags":[{"name":"Superhero","rank":93,"spoiler":false},{"name":"Crossdressing","rank":86,"spoiler":false},{"name":"Urban Fantasy","rank":83,"spoiler":false},{"name":"Noir","rank":82,"spoiler":