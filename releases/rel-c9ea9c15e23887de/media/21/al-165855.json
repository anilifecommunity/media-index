"year":2024},"status":"FINISHED","studios":[{"animation":true,"id":6634,"name":"East Fish Studio"},{"animation":false,"id":6815,"name":"DMM.com"},{"animation":false,"id":159,"name":"Kodansha"},{"animation":false,"id":145,"name":"TBS"},{"animation":false,"id":6421,"name":"Crunchyroll"},{"animation":false,"id":6339,"name":"Good Smile Company"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Hotaru Hinase is a first-year in high school that has a great family and wonderful friends, but not much luck when it comes to romance.\nOne day, she happens to see the hot boy from the class next door, Hananoi, get dumped. Seeing Hananoi standing in the middle of a park all alone, Hotaru decides to hand him an umbrella.\n\nThat little act causes Hananoi to ask her out soon after.\n\nWhat does love even mean? What does it mean to be in love? Hotaru is flustered at suddenly being asked out by Hananoi, who has an endless amount of love for the person he loves and wants to do everything he can for them. This is a story about first love between a girl who doesn't understand romantic love and a boy that may be a bit too heavy-handed when it comes to love.\n\n(Source: Kodansha USA)"},"tags":[{"name":"Shoujo","rank":95,"spoiler":false},{"name":"Heterosexual","rank":90,"spoiler":false},{"name":"Primarily Teen Cast","rank":84,"spoiler":false},{"name":"Female Protagonist","rank":75,"spoiler":false},{"name":"School","rank":72,"spoiler":false},{"name":"Yandere","rank":63,"spoiler":true},{"name":"Anti-Hero","rank":60,"spoiler":true},{"name":"Work","rank":50,"spoiler":false},{"name":"Aromantic","rank":45,"spoiler":false},{"name":"Bullying","rank":40,"spoiler":true},{"name":"Urban","rank":40,"spoiler":false},{"name":"Fake Relationship","rank":30,"spoiler":false},{"name":"Badminton","rank":26,"spoiler":false},{"name":"Love Triangle","rank":10,"spoiler":true}],"titles":{"display":"A Condition Called Love","english":"A Condition Called Love","native":"花野井くんと恋の病","romaji":"Han