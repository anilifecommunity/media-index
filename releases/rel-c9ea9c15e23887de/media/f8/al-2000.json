animation":false,"id":757,"name":"Sony Music Entertainment"},{"animation":true,"id":77,"name":"APPP"},{"animation":false,"id":113,"name":"Kadokawa Shoten"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"The Z Project was intended to give the new generation a break from caring for the old. The original intention was to create a machine to care for them without any intervention. At first glance, it looked like an excellent plan, and many of the younger generation approved of its application. But when old Mr. Takazawa became the test subject for the Z-001 machine, Haruko questioned both the tactics of the hospital and the moral implications of the machine. This is just the beginning, as Haruko has not just the hospital, but the odds against her. But then, she discovers an odd quirk about the machine: it uses a biochip, and it eventually acquires a mind of its own!\n\n(Source: AnimeNfo)"},"tags":[{"name":"Cyberpunk","rank":96,"spoiler":false},{"name":"Artificial Intelligence","rank":94,"spoiler":false},{"name":"Rehabilitation","rank":80,"spoiler":false},{"name":"Robots","rank":79,"spoiler":false},{"name":"Animals","rank":79,"spoiler":true},{"name":"Urban Fantasy","rank":79,"spoiler":false},{"name":"Satire","rank":77,"spoiler":false},{"name":"Primarily Adult Cast","rank":76,"spoiler":false},{"name":"Real Robot","rank":74,"spoiler":false},{"name":"Elderly Protagonist","rank":73,"spoiler":false},{"name":"Female Protagonist","rank":60,"spoiler":false},{"name":"Male Protagonist","rank":60,"spoiler":false},{"name":"Crime","rank":60,"spoiler":true},{"name":"Military","rank":56,"spoiler":false},{"name":"Fugitive","rank":52,"spoiler":true},{"name":"Politics","rank":50,"spoiler":false},{"name":"College","rank":40,"spoiler":false},{"name":"Conspiracy","rank":40,"spoiler":true}],"titles":{"display":"Roujin Z","english":"Roujin Z","native":"老人Ｚ","romaji":"Roujin Z","synonyms":[{"language":null,"source":"bangumi","value":"ROUJIN-Z"},{"language":null,"source":