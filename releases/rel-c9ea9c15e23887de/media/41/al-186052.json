":"MANGA","mediaKey":null,"name":"Mizu Zokusei no Mahou Tsukai@COMIC","node":{"countryOfOrigin":"JP","description":null,"episodes":null,"format":"MANGA","id":142704,"idMal":164607,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx142704-1UQHHzWl7doW.jpg","title":{"english":"The Water Magician","native":"水属性の魔法使い＠ＣＯＭＩＣ","romaji":"Mizu Zokusei no Mahou Tsukai@COMIC","userPreferred":"Mizu Zokusei no Mahou Tsukai@COMIC"}},"relationType":"ALTERNATIVE","resolved":false},{"ids":{"anilist":142688,"mal":164608},"kind":"MANGA","mediaKey":null,"name":"Mizu Zokusei no Mahou Tsukai Dai Ichi-bu: Chuuou Shokoku-hen","node":{"countryOfOrigin":"JP","description":null,"episodes":null,"format":"NOVEL","id":142688,"idMal":164608,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx142688-ShdIyM8TGqO8.jpg","title":{"english":"The Water Magician: The Central Provinces Arc","native":"水属性の魔法使い 第一部 中央諸国編","romaji":"Mizu Zokusei no Mahou Tsukai Dai Ichi-bu: Chuuou Shokoku-hen","userPreferred":"Mizu Zokusei no Mahou Tsukai Dai Ichi-bu: Chuuou Shokoku-hen"}},"relationType":"ADAPTATION","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":70},"season":"SUMMER","seasonYear":2025,"series":["al-186052"],"seriesIds":[186052],"startDate":{"day":4,"month":7,"year":2025},"status":"FINISHED","studios":[{"animation":true,"id":6143,"name":"TYPHOON GRAPHICS"},{"animation":true,"id":7597,"name":"Wonderland"},{"animation":false,"id":145,"name":"TBS"},{"animation":false,"id":6421,"name":"Crunchyroll"},{"animation":false,"id":6998,"name":"TO Books"},{"animation":false,"id":7156,"name":"Universal Music"},{"animation":false,"id":6616,"name":"BS11"},{"animation":true,"id":6143,"name":"TYPHOON GRAPHICS"},{"animation":false,"id":460,"name":"KLOCKWORX"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Ryou is delighted to be reincarnated into the fantastical world of Phi, where he thinks he’ll get to live a quiet life learning to use his newfound water magic. Going with the flow here, however, means something very different. Ryou is immediately pitted against the wild lands he winds up in and the slew of deadly monsters that call the remote subcontinent home. You’d think he’d forget about taking it easy when he’s stuck fighting for his life, but lucky for Ryou, he’s naturally optimistic, clever, and blessed with the hidden “Eternal Youth” trait. Twenty years pass in the blink of an eye, and each encounter along the way pushes him one step closer to the pinnacle of human magic. Little does he realize that’s only the opening chapter of his tale. A fateful meeting soon thrusts Ryou to the forefront of history, forever changing the course of his life... Thus begins the adventures of the strongest water magician the world has ever seen—who also likes to do things at his own pace!\n\n(Source: J-Novel Club)"},"tags":[{"name":"Isekai","rank":93,"spoiler":false},{"name":"Male Protagonist","rank":92,"spoiler":false},{"name":"Magic","rank":91,"spoiler":false},{"name":"Super Power","rank":79,"spoiler":true},{"name":"Class Struggle","rank":79,"spoiler":true},{"name":"Reincarnation","rank":73,"spoiler":true},{"name":"Dungeon","rank":71,"spoiler":false},{"name":"Snowscape","rank":65,"spoiler":false},{"name":"Travel","rank":61,"spoiler":false},{"name":"Demons","rank":60,"spoiler":false},{"name":"Elf","rank":58,"spoiler":false},{"name":"Alchemy","rank":56,"spoiler":true},{"name":"Survival","rank":53,"spoiler":false},{"name":"Anthropomorphism","rank":50,"spoiler":true},{"name":"Conspiracy","rank":50,"spoiler":true},{"name":"Dragons","rank":41,"spoiler":false},{"name":"Kuudere","rank":40,"spoiler":false},{"name":"Ensemble Cast","rank":40,"spoiler":true},{"name":"Coastal","rank":36,"spoiler":false},{"name":"Inn","rank":30,"spoiler":true},{"name":"Adoption","rank":20,"spoiler":true},{"name":"Time Skip","rank":20,"spoiler":true},{"name":"Tragedy","rank":20,"sp