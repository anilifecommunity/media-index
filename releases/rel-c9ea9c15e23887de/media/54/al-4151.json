dult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx109616-cPuNKosITAvn.jpg","title":{"english":"Blade of the Immortal (ONA)","native":"無限の住人-IMMORTAL-","romaji":"Mugen no Juunin: IMMORTAL","userPreferred":"Mugen no Juunin: IMMORTAL"}},"relationType":"ALTERNATIVE","resolved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":65},"season":"SUMMER","seasonYear":2008,"series":["al-4151"],"seriesIds":[4151],"startDate":{"day":14,"month":7,"year":2008},"status":"FINISHED","studios":[{"animation":true,"id":5,"name":"Bee Train"},{"animation":true,"id":10,"name":"Production I.G"},{"animation":false,"id":159,"name":"Kodansha"},{"animation":false,"id":250,"name":"Media Blasters"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Manji is an amoral swordsman, who has been cursed with eternal life. He has grown tired of living with all the death he has created. He has no skills other then those of killing, thus he forms a plan to regain his mortality: he shall kill one hundred evil men for each good one he has killed. The old witch who afflicted Manji with immortality agrees to Manji's proposition and Manji is set on his path to kill one thousand evil men. On his journey he meets a young girl, Rin, who has her own vengeance to seek against the sword school whose members slaughtered Rin's family. Rin and Manji journey together, each hoping to find some kind of peace. In their way are many varied enemies. Rin and Manji are almost constantly under attack and must learn to live their lives, avoiding being consumed by revenge.\n\n(Source: Anime News Network)"},"tags":[{"name":"Swordplay","rank":100,"spoiler":false},{"name":"Samurai","rank":80,"spoiler":false},{"name":"Historical","rank":79,"spoiler":false},{"name":"Seinen","rank":79,"spoiler":false},{"name":"Revenge","rank":79,"spoiler":false},{"name":"Tragedy","rank":79,"spoiler":true},{"name":"Primarily Adult Cast","rank":79,"spoiler":false},{"nam