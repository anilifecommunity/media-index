ots","rank":44,"spoiler":false},{"name":"Artificial Intelligence","rank":40,"spoiler":false},{"name":"Guns","rank":40,"spoiler":false},{"name":"War","rank":20,"spoiler":false},{"name":"School Club","rank":20,"spoiler":false},{"name":"Vampire","rank":20,"spoiler":true}],"titles":{"display":"The Asterisk War","english":"The Asterisk War","native":"学戦都市アスタリスク","romaji":"Gakusen Toshi Asterisk","synonyms":[{"language":"zh","source":"bangumi","value":"学战都市 六芒星"},{"language":null,"source":"bangumi","value":"学战都市Asterisk"},{"language":null,"source":"bangumi","value":"学战都市 阿斯塔利斯克"}]},"trailer":{"id":"oiLnJI7cTbk","site":"youtube","thumbnail":"https://i.ytimg.com/vi/oiLnJI7cTbk/hqdefault.jpg"},"visibility":"general"}