ing Cute Things","rank":98,"spoiler":false},{"name":"Primarily Female Cast","rank":90,"spoiler":false},{"name":"Seinen","rank":86,"spoiler":false},{"name":"Female Protagonist","rank":85,"spoiler":false},{"name":"Work","rank":82,"spoiler":false},{"name":"Foreign","rank":80,"spoiler":false},{"name":"Primarily Teen Cast","rank":80,"spoiler":false},{"name":"Maids","rank":78,"spoiler":false},{"name":"Primarily Child Cast","rank":75,"spoiler":false},{"name":"Tsundere","rank":67,"spoiler":false},{"name":"Episodic","rank":65,"spoiler":false},{"name":"Kuudere","rank":60,"spoiler":false},{"name":"Nudity","rank":60,"spoiler":false}],"titles":{"display":"Is the Order a Rabbit?","english":"Is the Order a Rabbit?","native":"ご注文はうさぎですか？","romaji":"Gochuumon wa Usagi desu ka?","synonyms":[{"language":"zh","source":"bangumi","value":"请问您今天要来点兔子吗？"},{"language":null,"source":"bangumi","value":"点兔"},{"language":null,"source":"bangumi","value":"Gochuumon wa Usagi Desuka?"},{"language":null,"source":"bangumi","value":"请问您点的是兔子吗？"},{"language":null,"source":"bangumi","value":"ごちうさ"}]},"trailer":{"id":"aWyPbj1CItQ","site":"youtube","thumbnail":"https://i.ytimg.com/vi/aWyPbj1CItQ/hqdefault.jpg"},"visibility":"general"}