es"},{"animation":false,"id":108,"name":"Media Factory"},{"animation":false,"id":109,"name":"Shouchiku"},{"animation":false,"id":142,"name":"Asatsu DK"},{"animation":false,"id":123,"name":"Victor Entertainment"},{"animation":false,"id":169,"name":"Fuji TV"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Ayato Kamina was separated from the girl he loved, Haruka Mishima, when an event occurred that was thought to have killed everyone outside of Tokyo. But one day three years later, invaders suddenly attacked the city. It was then that he meets an agent of TERRA, Haruka Shitow, who tells him that she will give him the truth about the world. It is the beginning of a series of strange events, which involve him activating a giant mecha, the RahXephon and finding out that many people, including his own mother, has blue blood, and that he was actually living in a self-encased dimension where time moves slower than that of the outside world.\n\n(Source: Anime News Network)"},"tags":[{"name":"Coming of Age","rank":79,"spoiler":false},{"name":"Post-Apocalyptic","rank":79,"spoiler":false},{"name":"Mythology","rank":60,"spoiler":false},{"name":"Philosophy","rank":60,"spoiler":false},{"name":"Military","rank":60,"spoiler":false},{"name":"Super Robot","rank":60,"spoiler":false},{"name":"Aliens","rank":60,"spoiler":false},{"name":"War","rank":60,"spoiler":false}],"titles":{"display":"RahXephon: The Motion Picture","english":"RahXephon: The Motion Picture","native":"ラーゼフォン 多元変奏曲","romaji":"RahXephon: Pluralitas Concentio","synonyms":[{"language":"zh","source":"bangumi","value":"翼神传说 多元变奏曲"},{"language":null,"source":"bangumi","value":"翼神世音 多元變奏曲"}]},"trailer":null,"visibility":"general"}