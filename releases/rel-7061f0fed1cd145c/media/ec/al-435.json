[435,1563],"startDate":{"day":17,"month":10,"year":1994},"status":"FINISHED","studios":[{"animation":true,"id":65,"name":"Tokyo Movie Shinsha"},{"animation":false,"id":467,"name":"Discotek"},{"animation":false,"id":76,"name":"Yomiuri TV"},{"animation":false,"id":53,"name":"Dentsu"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Three young girls, Hikaru, Umi, and Fuu, are transported to a magical world called Cephiro during a field trip to Tokyo Tower. They are soon greeted by Master Mage Clef, who explains to them that they have been summoned to become the Legendary Magic Knights and save Cephiro. The girls are less than enthusiastic about this idea, and only want to return home. Clef further explains that they must seek out the three Rune Gods to help them fight. He bestows armor and magical powers to each of them. They learn from Clef that High Priest Zagato has kidnapped the Pillar of Cephiro, Princess Emeraude. The Pillar of Cephiro has the sole responsibility of keeping Cephiro alive and in balance with her prayers. Without Princess Emeraude, Cephiro would fall into ruin. Hikaru, Umi, and Fuu must fight off Zagato's henchman and find the Rune Gods if they ever want to get back home. They soon learn that friendship and loyalty are the only things they can rely on in the crumbling Cephiro.\n\n(Source: Anime News Network)"},"tags":[{"name":"Magic","rank":92,"spoiler":false},{"name":"Super Power","rank":92,"spoiler":false},{"name":"Swordplay","rank":88,"spoiler":false},{"name":"Isekai","rank":86,"spoiler":false},{"name":"Female Protagonist","rank":81,"spoiler":false},{"name":"Medieval","rank":79,"spoiler":false},{"name":"Shoujo","rank":78,"spoiler":false},{"name":"Tragedy","rank":77,"spoiler":true},{"name":"Primarily Female Cast","rank":74,"spoiler":false},{"name":"Ojou-sama","rank":73,"spoiler":false},{"name":"Henshin","rank":69,"spoiler":false},{"name":"Super Robot","rank":69,"spoiler":false},{"name":"Primarily Teen Cast","rank":66,"spoi