rce: Sentai Filmworks)"},"tags":[{"name":"Butler","rank":100,"spoiler":false},{"name":"Crossdressing","rank":90,"spoiler":false},{"name":"School","rank":88,"spoiler":false},{"name":"Primarily Female Cast","rank":86,"spoiler":false},{"name":"Ojou-sama","rank":79,"spoiler":false},{"name":"Male Protagonist","rank":77,"spoiler":false},{"name":"Tsundere","rank":72,"spoiler":true},{"name":"Female Harem","rank":70,"spoiler":false},{"name":"Meta","rank":65,"spoiler":false},{"name":"Episodic","rank":62,"spoiler":false},{"name":"Tomboy","rank":60,"spoiler":false},{"name":"Nudity","rank":55,"spoiler":false},{"name":"Heterosexual","rank":40,"spoiler":false},{"name":"Otaku Culture","rank":30,"spoiler":false},{"name":"Yandere","rank":13,"spoiler":true},{"name":"Wrestling","rank":10,"spoiler":false}],"titles":{"display":"Mayo Chiki!","english":"Mayo Chiki!","native":"まよチキ!","romaji":"Mayo Chiki!","synonyms":[{"language":"zh","source":"bangumi","value":"迷茫管家与懦弱的我"}]},"trailer":null,"visibility":"general"}