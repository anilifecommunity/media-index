iler":false},{"name":"Shounen","rank":90,"spoiler":false},{"name":"Ensemble Cast","rank":79,"spoiler":false},{"name":"Body Horror","rank":79,"spoiler":true},{"name":"Guns","rank":79,"spoiler":false},{"name":"Family Life","rank":72,"spoiler":false},{"name":"Male Protagonist","rank":66,"spoiler":false},{"name":"Female Protagonist","rank":66,"spoiler":false},{"name":"Super Power","rank":66,"spoiler":false},{"name":"Heterosexual","rank":65,"spoiler":false},{"name":"Tragedy","rank":20,"spoiler":true},{"name":"Zombie","rank":20,"spoiler":true}],"titles":{"display":"Mission: Yozakura Family Season 2","english":"Mission: Yozakura Family Season 2","native":"夜桜さんちの大作戦 第2期","romaji":"Yozakura-san Chi no Daisakusen 2nd Season","synonyms":[{"language":"zh","source":"bangumi","value":"夜樱家的大作战 第二季"},{"language":null,"source":"bangumi","value":"Yozakura-san Chi no Daisakusen Season 2"}]},"trailer":{"id":"dirydQCBa6o","site":"youtube","thumbnail":"https://i.ytimg.com/vi/dirydQCBa6o/hqdefault.jpg"},"visibility":"general"}