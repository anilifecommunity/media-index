icial Website)"},"tags":[{"name":"Artificial Intelligence","rank":80,"spoiler":false},{"name":"Kids","rank":79,"spoiler":false},{"name":"Boys' Love","rank":79,"spoiler":false},{"name":"Male Protagonist","rank":73,"spoiler":false},{"name":"Virtual World","rank":73,"spoiler":false},{"name":"Primarily Child Cast","rank":70,"spoiler":false},{"name":"Robots","rank":60,"spoiler":true},{"name":"Henshin","rank":45,"spoiler":false},{"name":"Anthropomorphism","rank":40,"spoiler":false},{"name":"Kaiju","rank":40,"spoiler":true},{"name":"Proxy Battle","rank":40,"spoiler":false},{"name":"CGI","rank":33,"spoiler":false},{"name":"Crossdressing","rank":20,"spoiler":true}],"titles":{"display":"Digimon Universe App Monsters","english":"Digimon Universe App Monsters","native":"デジモンユニバース アプリモンスターズ","romaji":"Digimon Universe: Appli Monsters","synonyms":[{"language":"zh","source":"bangumi","value":"数码宝贝宇宙 应用怪兽"},{"language":null,"source":"bangumi","value":"Digimon Universe: App Monsters"},{"language":null,"source":"bangumi","value":"数码兽宇宙 应用怪兽"},{"language":null,"source":"bangumi","value":"数码兽系谱 应用怪兽"},{"language":null,"source":"bangumi","value":"数码宝贝-APP兽"},{"language":null,"source":"bangumi","value":"数码暴龙App世代"}]},"trailer":null,"visibility":"general"}