 the realm.\n\n(Source: Frontwing)"},"tags":[{"name":"Female Harem","rank":79,"spoiler":false},{"name":"Assassins","rank":79,"spoiler":false},{"name":"Guns","rank":77,"spoiler":false},{"name":"Female Protagonist","rank":77,"spoiler":false},{"name":"Primarily Female Cast","rank":73,"spoiler":false},{"name":"Tsundere","rank":60,"spoiler":false},{"name":"School","rank":42,"spoiler":false},{"name":"Teacher","rank":40,"spoiler":false},{"name":"Ninja","rank":40,"spoiler":false},{"name":"Swordplay","rank":30,"spoiler":false},{"name":"Gore","rank":20,"spoiler":false},{"name":"Cute Girls Doing Cute Things","rank":20,"spoiler":true}],"titles":{"display":"Grisaia: Phantom Trigger THE ANIMATION","english":null,"native":"グリザイア：ファントムトリガー THE ANIMATION","romaji":"Grisaia: Phantom Trigger THE ANIMATION","synonyms":[{"language":"zh","source":"bangumi","value":"灰色：幻影扳机 THE ANIMATION"},{"language":null,"source":"bangumi","value":"GRISAIA：PHANTOM TRIGGER"},{"language":null,"source":"bangumi","value":"灰色幻影扳机 01/02"},{"language":null,"source":"bangumi","value":"GRISAIA：PHANTOM TRIGGER  01/02"}]},"trailer":{"id":"LCQeMRnmwYE","site":"youtube","thumbnail":"https://i.ytimg.com/vi/LCQeMRnmwYE/hqdefault.jpg"},"visibility":"general"}