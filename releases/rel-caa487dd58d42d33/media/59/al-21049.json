ION","resolved":false},{"ids":{"anilist":98635,"mal":35466},"kind":"ANIME","mediaKey":"al-98635","name":"ReLIFE: Kanketsu-hen","node":{"countryOfOrigin":"JP","description":null,"episodes":4,"format":"OVA","id":98635,"idMal":35466,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx98635-U7XClVuynqfY.png","title":{"english":"ReLIFE: Final Arc","native":"ReLIFE 完結編","romaji":"ReLIFE: Kanketsu-hen","userPreferred":"ReLIFE: Kanketsu-hen"}},"relationType":"SEQUEL","resolved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":78},"season":"SUMMER","seasonYear":2016,"series":["al-21049","al-98635"],"seriesIds":[21049,98635],"startDate":{"day":24,"month":6,"year":2016},"status":"FINISHED","studios":[{"animation":true,"id":73,"name":"TMS Entertainment"},{"animation":false,"id":17,"name":"Aniplex"},{"animation":false,"id":777,"name":"Hakuhodo DY Music & Pictures"},{"animation":false,"id":7075,"name":"NHN Comico"},{"animation":false,"id":7077,"name":"C&I Entertainment"},{"animation":false,"id":7076,"name":"Lawson"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Dismissed as a hopeless loser by those around him, 27-year-old Arata Kaizaki bounces around from one job to another after quitting his first company. His unremarkable existence takes a sharp turn when he meets Ryou Yoake, a member of the ReLife Research Institute, who offers Arata the opportunity to change his life for the better with the help of a mysterious pill. Taking it without a second thought, Arata awakens the next day to find that his appearance has reverted to that of a 17-year-old.\n\nArata soon learns that he is now the subject of a unique experiment and must attend high school as a transfer student for one year. Though he initially believes it will be a cinch due to his superior life experience, Arata is proven horribly wrong on his first day: he flunks all his tests, is completely out of shape, and can't keep up with the new school policies that have cropped up in the last 10 years. Furthermore, Ryou has been assigned to observe him, bringing Arata endless annoyance. ReLIFE follows Arata's struggle to adjust to his hectic new lifestyle and avoid repeating his past mistakes, all while slowly discovering more about his fellow classmates.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Rehabilitation","rank":97,"spoiler":false},{"name":"Age Regression","rank":93,"spoiler":false},{"name":"School","rank":91,"spoiler":false},{"name":"Memory Manipulation","rank":82,"spoiler":true},{"name":"Male Protagonist","rank":81,"spoiler":false},{"name":"Heterosexual","rank":80,"spoiler":false},{"name":"Primarily Teen Cast","rank":78,"spoiler":false},{"name":"Coming of Age","rank":76,"spoiler":false},{"name":"Seinen","rank":72,"spoiler":false},{"name":"Hikikomori","rank":70,"spoiler":false},{"name":"Kuudere","rank":70,"spoiler":false},{"name":"Work","rank":64,"spoiler":false},{"name":"Time Manipulation","rank":63,"spoiler":true},{"name":"Age Gap","rank":61,"spoiler":true},{"name":"Tragedy","rank":60,"spoiler":true},{"name":"Suicide","rank":60,"spoiler":true},{"name":"Tsundere","rank":60,"spoiler":false},{"name":"Slapstick","rank":46,"spoiler":false},{"name":"Acting","rank":45,"spoiler":true},{"name":"Volleyball","rank":36,"spoiler":false},{"name":"Chibi","rank":30,"spoiler":false}],"titles":{"display":"ReLIFE","english":"ReLIFE","native":"ReLIFE","romaji":"ReLIFE","synonyms":[{"language":null,"source":"bangumi","value":"リライフ"},{"language":null,"source":"bangumi","value":"ReLIFE 重返17歲"},{"language":null,"source":"bangumi","value":"ReLIFE 重返17岁"},{"language":null,"source":"bangumi","value":"重生计划"}]},"trailer":{"id":"fZCgXuxMAZY","site":"youtube","thumbnail":"https://i.ytimg.com/vi/fZCgXuxMAZY/hqdefault.jpg"},"visibility":"general"}