: The anime was pre-screened in Japan theatrically for 3 weeks on July 14, 2023 before being aired as a two-part special on September 2 &  September 9, 2023."},"tags":[{"name":"Twins","rank":100,"spoiler":false},{"name":"Female Harem","rank":94,"spoiler":false},{"name":"Male Protagonist","rank":88,"spoiler":false},{"name":"Heterosexual","rank":83,"spoiler":false},{"name":"Shounen","rank":79,"spoiler":false},{"name":"Coming of Age","rank":76,"spoiler":false},{"name":"Tsundere","rank":68,"spoiler":false},{"name":"Kuudere","rank":66,"spoiler":false},{"name":"Ojou-sama","rank":64,"spoiler":false},{"name":"Ensemble Cast","rank":60,"spoiler":false},{"name":"Primarily Female Cast","rank":60,"spoiler":false}],"titles":{"display":"The Quintessential Quintuplets Specials","english":"The Quintessential Quintuplets Specials","native":"五等分の花嫁∽","romaji":"Go-toubun no Hanayome∽","synonyms":[{"language":"zh","source":"bangumi","value":"五等分的新娘∽"},{"language":null,"source":"bangumi","value":"Go-Toubun no Hanayome~"},{"language":null,"source":"bangumi","value":"The Quintessential Quintuplets ~"},{"language":null,"source":"bangumi","value":"五等分的花嫁∽"}]},"trailer":{"id":"FtiMzS9nH1s","site":"youtube","thumbnail":"https://i.ytimg.com/vi/FtiMzS9nH1s/hqdefault.jpg"},"visibility":"general"}