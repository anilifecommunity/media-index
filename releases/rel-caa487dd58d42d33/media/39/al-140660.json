s up their arms and starts a conquest trying to save all the people from the disease.\n\n(Source: Official Site, translated, edited)"},"tags":[{"name":"Tragedy","rank":99,"spoiler":true},{"name":"Pandemic","rank":96,"spoiler":false},{"name":"Terrorism","rank":94,"spoiler":false},{"name":"Conspiracy","rank":93,"spoiler":true},{"name":"Urban","rank":88,"spoiler":false},{"name":"War","rank":87,"spoiler":false},{"name":"Dystopian","rank":86,"spoiler":false},{"name":"Female Protagonist","rank":86,"spoiler":false},{"name":"Super Power","rank":84,"spoiler":false},{"name":"Amnesia","rank":83,"spoiler":false},{"name":"Kemonomimi","rank":80,"spoiler":false},{"name":"Primarily Female Cast","rank":80,"spoiler":true},{"name":"Magic","rank":73,"spoiler":false},{"name":"Medicine","rank":72,"spoiler":false},{"name":"Found Family","rank":72,"spoiler":true},{"name":"Military","rank":70,"spoiler":false},{"name":"Guns","rank":61,"spoiler":false},{"name":"Coming of Age","rank":60,"spoiler":true},{"name":"Twins","rank":54,"spoiler":true},{"name":"Post-Apocalyptic","rank":40,"spoiler":false}],"titles":{"display":"Arknights: PRELUDE TO DAWN","english":"Arknights: PRELUDE TO DAWN","native":"アークナイツ 黎明前奏","romaji":"Arknights: Reimei Zensou","synonyms":[{"language":"ja","source":"bangumi","value":"アークナイツ【黎明前奏/PRELUDE TO DAWN】"},{"language":"zh","source":"bangumi","value":"明日方舟：黎明前奏"},{"language":null,"source":"bangumi","value":"アークナイツ -黎明前奏-"}]},"trailer":{"id":"_Q4zGuEqi8c","site":"youtube","thumbnail":"https://i.ytimg.com/vi/_Q4zGuEqi8c/hqdefault.jpg"},"visibility":"general"}