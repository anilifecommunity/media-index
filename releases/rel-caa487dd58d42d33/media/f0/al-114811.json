t":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/b137323-qa5VTnBZWsY5.png","title":{"english":null,"native":"デジモンアドベンチャーVテイマー01 〜新たなる勇気〜","romaji":"Digimon Adventure V-Tamer 01: Aratanaru Yuuki","userPreferred":"Digimon Adventure V-Tamer 01: Aratanaru Yuuki"}},"relationType":"CHARACTER","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":63},"season":"SPRING","seasonYear":2020,"series":["al-114811"],"seriesIds":[114811],"startDate":{"day":5,"month":4,"year":2020},"status":"FINISHED","studios":[{"animation":true,"id":18,"name":"Toei Animation"},{"animation":false,"id":169,"name":"Fuji TV"},{"animation":false,"id":675,"name":"Yomiuri Advertising"},{"animation":true,"id":36,"name":"Studio Gallop"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"It's the year 2020. The Network has become something humans can no longer do without in their daily lives. But what humans don't know is that on the other side of the Network is the Digital World, a realm of light and darkness. Nor are they aware of the Digimon who live there.\n\nWidespread Network difficulties arise, centered around the Tokyo area. Traffic signals blink chaotically, public outdoor TVs display garbled text, and so on. The news reports it as a case of cyberterrorism.\n\nFifth grader Taichi Yagami stayed home by himself to get ready for a weekend summer camp, but his mother and little sister Hikari went to Shibuya, and now they're aboard a runaway train. Taichi Hurries to Shibuya to save his mother and sister, but the instant he heads toward the station platform... a strange phenomenon befalls the DigiDestined, and Taichi goes to the Digital World! The DigiDestined meet their partner Digimon, and they're faced with an adventure into the unknown...!\n\n(Source: FUJI TELEVISION NETWORK, INC.)"},"tags":[{"name":"Virtual World","rank":94,"spoiler":false},{"name":"Primarily Child Cast","rank":88,"spoiler":false},{"name":"Angels","rank":79,"spoiler":false},{"name":"Anthropomorphism","rank":79,"spoiler":false},{"name":"Kaiju","rank":74,"spoiler":false},{"name":"Artificial Intelligence","rank":70,"spoiler":false},{"name":"Henshin","rank":70,"spoiler":false},{"name":"Kids","rank":66,"spoiler":false},{"name":"Proxy Battle","rank":60,"spoiler":false}],"titles":{"display":"Digimon Adventure:","english":"Digimon Adventure:","native":"デジモンアドベンチャー:","romaji":"Digimon Adventure:","synonyms":[{"language":"zh","source":"bangumi","value":"数码宝贝大冒险："},{"language":null,"source":"bangumi","value":"数码宝贝："},{"language":null,"source":"bangumi","value":"数码兽大冒险："},{"language":null,"source":"bangumi","value":"数码暴龙：重启之战"},{"language":null,"source":"bangumi","value":"デジモンアドベンチャーΨ"},{"language":null,"source":"bangumi","value":"数码兽大冒险Ψ"}]},"trailer":{"id":"fmfR2nR_RRY","site":"youtube","thumbnail":"https://i.ytimg.com/vi/fmfR2nR_RRY/hqdefault.jpg"},"visibility":"general"}