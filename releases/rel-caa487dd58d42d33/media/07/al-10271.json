 have an opportunity to repay his debt… with 15 years of hard labor.\n\n(Source: Sea Slugs)"},"tags":[{"name":"Gambling","rank":99,"spoiler":false},{"name":"Seinen","rank":92,"spoiler":false},{"name":"Primarily Adult Cast","rank":90,"spoiler":false},{"name":"Primarily Male Cast","rank":88,"spoiler":false},{"name":"Male Protagonist","rank":80,"spoiler":false},{"name":"Class Struggle","rank":79,"spoiler":false},{"name":"Philosophy","rank":79,"spoiler":false},{"name":"Survival","rank":79,"spoiler":false},{"name":"Slavery","rank":78,"spoiler":false},{"name":"Card Battle","rank":73,"spoiler":false},{"name":"Crime","rank":66,"spoiler":false},{"name":"Torture","rank":60,"spoiler":true},{"name":"Bullying","rank":40,"spoiler":true},{"name":"Food","rank":30,"spoiler":false},{"name":"Tragedy","rank":20,"spoiler":true}],"titles":{"display":"Kaiji - Against All Rules","english":"Kaiji - Against All Rules","native":"逆境無頼カイジ 破戒録篇","romaji":"Gyakkyou Burai Kaiji: Hakairoku-hen","synonyms":[{"language":"zh","source":"bangumi","value":"赌博默示录 破戒录篇"},{"language":null,"source":"bangumi","value":"逆境无赖开司 破戒录篇"},{"language":null,"source":"bangumi","value":"逆境无赖开司 第二季"},{"language":null,"source":"bangumi","value":"赌博破戒录"}]},"trailer":{"id":"EK1LiaJ-TSU","site":"youtube","thumbnail":"https://i.ytimg.com/vi/EK1LiaJ-TSU/hqdefault.jpg"},"visibility":"general"}