:["al-3285"],"seriesIds":[3285],"startDate":{"day":6,"month":1,"year":1969},"status":"FINISHED","studios":[{"animation":true,"id":18,"name":"Toei Animation"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Atsuko \"Akko-chan\" Kagami (known variously as \"Stilly,\" \"Caroline,\" or \"Julie\" in Western versions of the anime) is an energetic elementary school girl who has an affinity for mirrors. One day, her favorite mirror which was given to Akko by her mother (or in some versions, by her father, as a present from India) is broken, and she prefers to bury it in her yard rather than throw it to the trash can. In her dreams, she is contacted by a spirit (or in some cases the Queen of the Mirror Kingdom) who is moved that the little girl would treat the mirror so respectfully and not simply throw it away. Akko-chan is then given the gift of a magical mirror and taught an enchantment that will allow her to transform into anything she wishes.\n\n(Source: Wikipedia)"},"tags":[{"name":"Shoujo","rank":79,"spoiler":false},{"name":"Female Protagonist","rank":73,"spoiler":false},{"name":"Shapeshifting","rank":60,"spoiler":false},{"name":"Magic","rank":60,"spoiler":false},{"name":"Primarily Child Cast","rank":50,"spoiler":false}],"titles":{"display":"Himitsu no Akko-chan","english":null,"native":"ひみつのアッコちゃん","romaji":"Himitsu no Akko-chan","synonyms":[{"language":"zh","source":"bangumi","value":"甜蜜小天使"},{"language":null,"source":"bangumi","value":"亚子的秘密"},{"language":null,"source":"bangumi","value":"小魔镜"}]},"trailer":null,"visibility":"general"}