":[7465],"startDate":{"day":6,"month":3,"year":2010},"status":"FINISHED","studios":[{"animation":true,"id":84,"name":"Studio Rikka"},{"animation":false,"id":324,"name":"Directions"},{"animation":true,"id":325,"name":"Code"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Sometime in future Japan, androids have been involved in every aspect of peoples lives. One day, upon checking his android's behavioral log, Rikuo, a student, noticed his android's returning times have been odd recently. With his friend Masaki, they found out the place where his android, Sammy, have been visiting: a small cafe called Eve no Jikan where androids and human are not seen as different. Upon talking with the \"people\" in the cafe and discovering more of Sammy's behavior, Rikuo changed his view about androids and treat them as friends rather than tools. At the same time, elsewhere in Japan, the Ethics committee is trying to impose policies to reduce the involvement and use of androids in society.\n\n(Source: Anime News Network)\n\nNote: The movie version is the complete version of the story. It includes all the OVAs and completely new scenes giving details on the background story of some characters."},"tags":[{"name":"Robots","rank":95,"spoiler":false},{"name":"Artificial Intelligence","rank":93,"spoiler":false},{"name":"Bar","rank":86,"spoiler":false},{"name":"Philosophy","rank":85,"spoiler":false},{"name":"Male Protagonist","rank":80,"spoiler":false},{"name":"Cyberpunk","rank":79,"spoiler":true},{"name":"Heterosexual","rank":79,"spoiler":false},{"name":"Software Development","rank":79,"spoiler":true},{"name":"Anthropomorphism","rank":70,"spoiler":true},{"name":"Found Family","rank":70,"spoiler":true},{"name":"Memory Manipulation","rank":60,"spoiler":true},{"name":"CGI","rank":47,"spoiler":false}],"titles":{"display":"Time of Eve: The Movie","english":"Time of Eve: The Movie","native":"イヴの時間 劇場版","romaji":"Eve no Jikan Movie","synonyms":[{"language":"zh","source":