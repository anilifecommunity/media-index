asonYear":1978,"series":["al-3335"],"seriesIds":[3335],"startDate":{"day":3,"month":6,"year":1978},"status":"FINISHED","studios":[{"animation":true,"id":22,"name":"Nippon Animation"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Set in the 1920s, Haikara-san ga Tooru is the story of the high-spirited tomboy Benio and her relationship with a handsome half-German soldier named Shinobu. Benio is a very outgoing and athletic girl with firm ideas about being able to live her life as she wants to. When she first meets Shinobu, she dislikes him intensely, even though he manages to help her out of a series of embarrassing mishaps. She is therefore surprised when she finds out that she has been forced into an arranged marriage and that her husband-to-be is none other than Shinobu! The story then has many twists and turns, as Shinobu has to fight in the war, Benio has to wrangle with the idea of getting married, and getting along with her future in-laws and employer. Meanwhile, the great Kanto earthquake looms in the future..."},"tags":[{"name":"Shoujo","rank":79,"spoiler":false},{"name":"Historical","rank":79,"spoiler":false},{"name":"War","rank":79,"spoiler":false},{"name":"Tomboy","rank":79,"spoiler":false},{"name":"School","rank":79,"spoiler":false},{"name":"Marriage","rank":79,"spoiler":false},{"name":"Military","rank":79,"spoiler":false},{"name":"Arranged Marriage","rank":73,"spoiler":false},{"name":"Femboy","rank":60,"spoiler":false},{"name":"Coming of Age","rank":60,"spoiler":false},{"name":"Crossdressing","rank":53,"spoiler":false}],"titles":{"display":"Smart-san","english":"Smart-san","native":"はいからさんが通る","romaji":"Haikara-san ga Tooru","synonyms":[{"language":"zh","source":"bangumi","value":"窈窕淑女"},{"language":null,"source":"bangumi","value":"小女子亚珊"}]},"trailer":null,"visibility":"general"}