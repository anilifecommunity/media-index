. With their help, Sasahara slowly adjusts to otaku life in Genshiken.\n\n(Source: AnimeNfo)"},"tags":[{"name":"Otaku Culture","rank":100,"spoiler":false},{"name":"School Club","rank":84,"spoiler":false},{"name":"Parody","rank":80,"spoiler":false},{"name":"College","rank":77,"spoiler":false},{"name":"Cosplay","rank":76,"spoiler":false},{"name":"Ensemble Cast","rank":75,"spoiler":false},{"name":"Meta","rank":73,"spoiler":false},{"name":"Heterosexual","rank":70,"spoiler":false},{"name":"Primarily Adult Cast","rank":66,"spoiler":false},{"name":"Seinen","rank":60,"spoiler":false},{"name":"Male Protagonist","rank":60,"spoiler":false},{"name":"Video Games","rank":55,"spoiler":false}],"titles":{"display":"Genshiken","english":"Genshiken","native":"げんしけん","romaji":"Genshiken","synonyms":[{"language":"zh","source":"bangumi","value":"现视研"},{"language":null,"source":"bangumi","value":"THE SOCIETY FOR THE STUDY OF MODERN VISUAL CULTURE"}]},"trailer":null,"visibility":"general"}