dia/manga/cover/medium/bx160495-dhgTXz9dYvp4.jpg","title":{"english":null,"native":"若おかみは小学生!","romaji":"Wakaokami wa Shougakusei!","userPreferred":"Wakaokami wa Shougakusei!"}},"relationType":"ALTERNATIVE","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":74},"season":"SUMMER","seasonYear":2018,"series":["al-101478"],"seriesIds":[101478],"startDate":{"day":21,"month":9,"year":2018},"status":"FINISHED","studios":[{"animation":true,"id":11,"name":"MADHOUSE"},{"animation":true,"id":276,"name":"DLE"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"After reluctantly being dragged to a festival at her parents' rural hometown, Oriko \"Okko\" Seki must face her sudden harsh reality: the death of both of her parents in a car accident shortly after they arrive. Now, Okko must live at her grandmother's traditional hot springs inn, which she is surprised to find is occupied by the ghost of a barefoot child. He encourages Okko to follow in her grandmother's footsteps and prepare to inherit the inn.\n\nInitially, Okko struggles to keep up with the responsibilities of the inn and the accommodation of guests. However, her parents told her that an inn is welcoming for everyone, and she strives to honor their memory. After discovering a few other spirits around the village, Okko learns that even though her parents are gone, she does not have to be lonely.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Ghost","rank":92,"spoiler":false},{"name":"Female Protagonist","rank":83,"spoiler":false},{"name":"Demons","rank":79,"spoiler":false},{"name":"Primarily Child Cast","rank":79,"spoiler":false},{"name":"Inn","rank":79,"spoiler":false},{"name":"Work","rank":76,"spoiler":false},{"name":"Rural","rank":60,"spoiler":false},{"name":"Ojou-sama","rank":60,"spoiler":false},{"name":"CGI","rank":48,"spoiler":false}],"titles":{"display":"Okko's Inn","english":"Okko's Inn","native":"若おかみは小学生！(劇場版)","romaji":"Wakaokami wa Shougakusei! (Movi