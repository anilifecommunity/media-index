Year":1974,"series":["al-3720"],"seriesIds":[3720],"startDate":{"day":20,"month":7,"year":1974},"status":"FINISHED","studios":[{"animation":true,"id":86,"name":"Group TAC"},{"animation":false,"id":7011,"name":"Nippon Herald Eiga"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"An old fairy tale gets some new wrinkles in this fanciful animated adaptation. After young Jack is conned into trading his family's prize cow for a handful of beans, he plants them and discovers they produce a magical vine that rises through the clouds. Climbing the beanstalk, Jack encounters a strange and remarkable world ruled by the magical Princess Margaret. The princess is in love with Prince Tulip despite his unattractive features and harsh personality, but as it turns out, this is the work of Madam Noir, an evil witch who has cast a spell on the princess so she will marry Tulip, her only son. Can Jack help the princess avoid this awful fate? Directed by Japanese animator Gisaburo Sugii, this free adaptation of Jack and the Beanstalk has won a cult following for its fanciful story and wildly colorful design."},"tags":[{"name":"Fairy Tale","rank":79,"spoiler":false},{"name":"Witch","rank":79,"spoiler":false},{"name":"Musical Theater","rank":79,"spoiler":false},{"name":"Kids","rank":70,"spoiler":false},{"name":"Male Protagonist","rank":60,"spoiler":false},{"name":"Magic","rank":60,"spoiler":false}],"titles":{"display":"Jack And The Beanstalk","english":"Jack And The Beanstalk","native":"ジャックと豆の木","romaji":"Jack to Mame no Ki","synonyms":[{"language":"zh","source":"bangumi","value":"杰克与豌豆"}]},"trailer":null,"visibility":"general"}