cular showdown . . .\n\n(Source: nationmaster.com)"},"tags":[{"name":"Mythology","rank":79,"spoiler":false},{"name":"Dragons","rank":70,"spoiler":false},{"name":"Kids","rank":60,"spoiler":false},{"name":"Gods","rank":60,"spoiler":false},{"name":"Swordplay","rank":40,"spoiler":false},{"name":"Male Protagonist","rank":40,"spoiler":false},{"name":"Animals","rank":20,"spoiler":false}],"titles":{"display":"Orochi, the Eight-Headed Dragon","english":"Orochi, the Eight-Headed Dragon","native":"わんぱく王子の大蛇退治","romaji":"Wanpaku Ouji no Orochi Taiji","synonyms":[{"language":"zh","source":"bangumi","value":"小王子与八头龙"},{"language":null,"source":"bangumi","value":"淘气王子战大蛇"},{"language":null,"source":"bangumi","value":"わんぱくおうじのおろちたいじ"},{"language":null,"source":"bangumi","value":"The Little Prince and the Eight-Headed Dragon"}]},"trailer":null,"visibility":"general"}