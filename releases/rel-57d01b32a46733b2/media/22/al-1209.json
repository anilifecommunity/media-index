 role and strives for glory.\n\n(Source: Anime News Network, edited)"},"tags":[{"name":"Cycling","rank":92,"spoiler":false},{"name":"Primarily Adult Cast","rank":79,"spoiler":false},{"name":"Foreign","rank":72,"spoiler":false},{"name":"Primarily Male Cast","rank":68,"spoiler":false},{"name":"Outdoor Activities","rank":60,"spoiler":false},{"name":"Male Protagonist","rank":40,"spoiler":false},{"name":"Seinen","rank":40,"spoiler":false},{"name":"Bar","rank":30,"spoiler":false}],"titles":{"display":"Nasu: Summer in Andalusia","english":"Nasu: Summer in Andalusia","native":"茄子 アンダルシアの夏","romaji":"Nasu: Andalusia no Natsu","synonyms":[{"language":"zh","source":"bangumi","value":"茄子：安达卢西亚之夏"},{"language":null,"source":"bangumi","value":"茄子 安达鲁西亚之夏"}]},"trailer":null,"visibility":"general"}