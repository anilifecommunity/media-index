asonYear":2011,"series":["al-9000"],"seriesIds":[9000],"startDate":{"day":1,"month":10,"year":2011},"status":"FINISHED","studios":[{"animation":true,"id":11,"name":"MADHOUSE"},{"animation":false,"id":16,"name":"TV Tokyo"},{"animation":true,"id":73,"name":"TMS Entertainment"},{"animation":false,"id":166,"name":"Movic"},{"animation":false,"id":372,"name":"NIS America Inc."}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"The war between the Levamme Empire and the Amatsukami Imperium has been raging for years. In the midst of this struggle, the prince of the Levamme Empire declares his love for Juana del Moral and vows to end the war in one year, as part of his marriage proposal. When the Amatsukami catch wind of this, they assault the del Moral residence, targeting Juana's life. As a last ditch effort to bring the prince his bride, the San Maltilia Airforce hires a mercenary of mixed blood—a bestado—to fly Juana to the Levamme capital in secret. The pilot, Charles, accepts the mission...but traversing an ocean alone, into enemy territory, proves a much more dangerous ordeal than anyone could have anticipated.\n\n(Source: NIS America)"},"tags":[{"name":"Aviation","rank":85,"spoiler":false},{"name":"Military","rank":79,"spoiler":false},{"name":"Male Protagonist","rank":79,"spoiler":false},{"name":"Survival","rank":79,"spoiler":false},{"name":"Female Protagonist","rank":79,"spoiler":false},{"name":"War","rank":66,"spoiler":false},{"name":"Politics","rank":46,"spoiler":false},{"name":"Primarily Adult Cast","rank":20,"spoiler":false}],"titles":{"display":"The Princess and the Pilot","english":"The Princess and the Pilot","native":"とある飛空士への追憶","romaji":"Toaru Hikuushi e no Tsuioku","synonyms":[{"language":"zh","source":"bangumi","value":"对某飞行员的追忆"},{"language":null,"source":"bangumi","value":"To aru hikuushi e no tsuioku"},{"language":null,"source":"bangumi","value":"对某个飞行员的追忆"}]},"trailer":{"id":"SgZ8TB1k0AE","site":"youtube","thumbnail":"https://i.