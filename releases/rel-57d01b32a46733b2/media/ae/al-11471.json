ion":null,"episodes":null,"format":"MANGA","id":31658,"idMal":1658,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx31658-xZFgMcIzhbB4.png","title":{"english":"Dororo","native":"どろろ","romaji":"Dororo","userPreferred":"Dororo"}},"relationType":"ADAPTATION","resolved":false},{"ids":{"anilist":5760,"mal":5760},"kind":"ANIME","mediaKey":"al-5760","name":"Dororo to Hyakkimaru","node":{"countryOfOrigin":"JP","description":null,"episodes":26,"format":"TV","id":5760,"idMal":5760,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b5760-0nnYt4GrL1NO.png","title":{"english":"Dororo","native":"どろろと百鬼丸","romaji":"Dororo to Hyakkimaru","userPreferred":"Dororo to Hyakkimaru"}},"relationType":"PARENT","resolved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":55},"season":"WINTER","seasonYear":1968,"series":["al-11471"],"seriesIds":[11471],"startDate":{"day":16,"month":1,"year":1968},"status":"FINISHED","studios":[],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Before producing a TV series, a pilot film was made to let sponsors and television stations grasp the work's pervasive quality. This is the pilot film for \"Dororo\" in which the characters are closer to those of the original story compared to the characters in the TV series. The faces and personalities of the characters in the TV series are altered from time to time to gain popularity among its viewers. As a result, sometimes viewers really loved it, but at other times it didn't go over as well. The pilot for \"Dororo\" was made in color, but the TV series was monochrome due to a tighter budget. The story depicts a journey in which the boy thief named Dororo and a cursed man called Hyakkimaru destroy monsters. Hyakkimaru can be a complete \"human\" only after he destroys 48 devils.\n\n(Source: Official site)"},"tags":[{"name":"Shounen","rank":60,"spoiler":false},{"name":"Historical","rank":