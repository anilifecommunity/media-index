 case...\n\n(Source: Anime News Network)"},"tags":[{"name":"Primarily Adult Cast","rank":90,"spoiler":false},{"name":"Foreign","rank":83,"spoiler":false},{"name":"Classic Literature","rank":82,"spoiler":false},{"name":"Historical","rank":82,"spoiler":false},{"name":"Politics","rank":76,"spoiler":false},{"name":"Male Protagonist","rank":70,"spoiler":false},{"name":"Desert","rank":60,"spoiler":false},{"name":"Swordplay","rank":53,"spoiler":false},{"name":"Tragedy","rank":50,"spoiler":true},{"name":"Mythology","rank":50,"spoiler":false},{"name":"Gore","rank":46,"spoiler":false},{"name":"Marriage","rank":20,"spoiler":false},{"name":"Nudity","rank":10,"spoiler":false}],"titles":{"display":"Hashire Melos (1992)","english":null,"native":"走れメロス (1992)","romaji":"Hashire Melos (1992)","synonyms":[{"language":"ja","source":"bangumi","value":"走れメロス"},{"language":"zh","source":"bangumi","value":"跑吧！美乐斯"},{"language":null,"source":"bangumi","value":"奔跑吧 梅勒斯"},{"language":null,"source":"bangumi","value":"Hashire Melos!"}]},"trailer":null,"visibility":"general"}