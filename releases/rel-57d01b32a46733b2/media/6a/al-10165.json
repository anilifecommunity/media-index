is"},{"animation":false,"id":113,"name":"Kadokawa Shoten"},{"animation":false,"id":166,"name":"Movic"},{"animation":false,"id":211,"name":"Rakuonsha"},{"animation":false,"id":233,"name":"Bandai Entertainment"},{"animation":false,"id":352,"name":"Kadokawa Pictures Japan"},{"animation":false,"id":460,"name":"KLOCKWORX"},{"animation":true,"id":929,"name":"Animation Do"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Nichijou primarily focuses on the daily antics of a trio of childhood friends—high school girls Mio Naganohara, Yuuko Aioi and Mai Minakami—whose stories soon intertwine with the young genius Hakase Shinonome, her robot caretaker Nano, and their talking cat Sakamoto. With every passing day, the lives of these six, as well as of the many people around them, experience both the calms of normal life and the insanity of the absurd. Walking to school, being bitten by a talking crow, spending time with friends, and watching the principal suplex a deer: they are all in a day's work in the extraordinary everyday lives of those in Nichijou.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Surreal Comedy","rank":97,"spoiler":false},{"name":"Episodic","rank":94,"spoiler":false},{"name":"Slapstick","rank":94,"spoiler":false},{"name":"School","rank":88,"spoiler":false},{"name":"Female Protagonist","rank":88,"spoiler":false},{"name":"Ensemble Cast","rank":86,"spoiler":false},{"name":"Primarily Teen Cast","rank":85,"spoiler":false},{"name":"Primarily Female Cast","rank":83,"spoiler":false},{"name":"Parody","rank":76,"spoiler":false},{"name":"Cute Girls Doing Cute Things","rank":73,"spoiler":false},{"name":"Achronological Order","rank":71,"spoiler":false},{"name":"Robots","rank":61,"spoiler":false},{"name":"Camping","rank":60,"spoiler":false},{"name":"Shounen","rank":48,"spoiler":false},{"name":"Body Horror","rank":46,"spoiler":false},{"name":"Drawing","rank":44,"spoiler":false},{"name":"Tsundere","rank":42,"spoiler":false},{"name":"Love Triangle","rank