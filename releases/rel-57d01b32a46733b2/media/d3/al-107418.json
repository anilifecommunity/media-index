ng wounds from the previous conflict, and there are terrorist groups bent on revenge. This is the story of Fairy Soldiers seeking their own justice in a chaotic postwar world.\n\n(Source: Anime News Network)"},"tags":[{"name":"Primarily Adult Cast","rank":95,"spoiler":false},{"name":"Military","rank":92,"spoiler":false},{"name":"War","rank":80,"spoiler":false},{"name":"Female Protagonist","rank":75,"spoiler":false},{"name":"Politics","rank":75,"spoiler":false},{"name":"CGI","rank":72,"spoiler":false},{"name":"Magic","rank":70,"spoiler":false},{"name":"Guns","rank":68,"spoiler":false},{"name":"Steampunk","rank":65,"spoiler":false},{"name":"Espionage","rank":60,"spoiler":false},{"name":"Fairy","rank":60,"spoiler":false},{"name":"Swordplay","rank":55,"spoiler":false},{"name":"Foreign","rank":50,"spoiler":false},{"name":"Urban Fantasy","rank":50,"spoiler":false},{"name":"Mafia","rank":46,"spoiler":false},{"name":"Terrorism","rank":40,"spoiler":false},{"name":"Revenge","rank":40,"spoiler":false},{"name":"Demons","rank":31,"spoiler":false},{"name":"Urban","rank":20,"spoiler":false}],"titles":{"display":"Fairy gone","english":"Fairy gone","native":"フェアリーゴーン","romaji":"Fairy Gone","synonyms":[{"language":"ja","source":"bangumi","value":"Fairy gone フェアリーゴーン"}]},"trailer":{"id":"VUX5l3uAqLI","site":"youtube","thumbnail":"https://i.ytimg.com/vi/VUX5l3uAqLI/hqdefault.jpg"},"visibility":"general"}