nth":1,"year":2017},"status":"FINISHED","studios":[{"animation":true,"id":27,"name":"Xebec"},{"animation":true,"id":6420,"name":"Issen"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Kasumi Toyama was enthralled by the stars as a young girl, so when she discovers a trail of star-shaped signs one day after transferring to a new school, she can't help but follow them. They lead her to a shop run by the grandmother of one of her new classmates, and Kasumi finds something that will change her life forever: a star-shaped guitar! And just like that, Kasumi knows that forming a band is her destiny.\n\nOf course, convincing Arisa and her grandmother to sell her the guitar won't be easy, and finding a group of other girls who want to become musicians will be even harder. But when a girl has stars in her eyes and a starbeat in her heart, there's nothing that will stop Kasumi from making her fantasies come true!\n\n(Source: Sentai Filmworks)"},"tags":[{"name":"Band","rank":100,"spoiler":false},{"name":"Primarily Teen Cast","rank":97,"spoiler":false},{"name":"Primarily Female Cast","rank":93,"spoiler":false},{"name":"Female Protagonist","rank":92,"spoiler":false},{"name":"Rock Music","rank":90,"spoiler":false},{"name":"School","rank":78,"spoiler":false},{"name":"Cute Girls Doing Cute Things","rank":78,"spoiler":false},{"name":"CGI","rank":72,"spoiler":false},{"name":"Urban","rank":66,"spoiler":false},{"name":"Chuunibyou","rank":66,"spoiler":false},{"name":"Tsundere","rank":64,"spoiler":false},{"name":"Swimming","rank":42,"spoiler":false},{"name":"Yuri","rank":40,"spoiler":false}],"titles":{"display":"BanG Dream!","english":"BanG Dream!","native":"BanG Dream!（バンドリ！）","romaji":"BanG Dream!","synonyms":[{"language":null,"source":"bangumi","value":"バンドリ！"},{"language":null,"source":"bangumi","value":"炸梦！"}]},"trailer":{"id":"yNMj1ZwB9QY","site":"youtube","thumbnail":"https://i.ytimg.com/vi/yNMj1ZwB9QY/hqdefault.jpg"},"visibility":"general"}