","rank":90,"spoiler":false},{"name":"Meta","rank":84,"spoiler":false},{"name":"Urban Fantasy","rank":83,"spoiler":false},{"name":"Time Skip","rank":80,"spoiler":true},{"name":"Conspiracy","rank":80,"spoiler":true},{"name":"Female Protagonist","rank":79,"spoiler":false},{"name":"Heterosexual","rank":79,"spoiler":false},{"name":"Kuudere","rank":66,"spoiler":false},{"name":"Love Triangle","rank":62,"spoiler":true},{"name":"Amnesia","rank":61,"spoiler":false},{"name":"School Club","rank":60,"spoiler":false},{"name":"School","rank":51,"spoiler":false},{"name":"Tragedy","rank":46,"spoiler":true}],"titles":{"display":"Sagrada Reset","english":"Sagrada Reset","native":"サクラダリセット","romaji":"Sagrada Reset","synonyms":[{"language":"zh","source":"bangumi","value":"重启咲良田"},{"language":null,"source":"bangumi","value":"咲良田重置"}]},"trailer":{"id":"a4Bgb_Q7bq4","site":"youtube","thumbnail":"https://i.ytimg.com/vi/a4Bgb_Q7bq4/hqdefault.jpg"},"visibility":"general"}