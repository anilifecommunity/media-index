h of evil lingers at the scene... Enma's fire rips through the darkness!\n\n(Source: Bandai Entertainment)"},"tags":[{"name":"Demons","rank":100,"spoiler":false},{"name":"Magic","rank":79,"spoiler":false},{"name":"Youkai","rank":79,"spoiler":false},{"name":"Heterosexual","rank":79,"spoiler":false},{"name":"Urban Fantasy","rank":76,"spoiler":false},{"name":"Gore","rank":72,"spoiler":false},{"name":"Seinen","rank":66,"spoiler":false},{"name":"Nudity","rank":60,"spoiler":false},{"name":"Detective","rank":60,"spoiler":false},{"name":"Age Regression","rank":60,"spoiler":false},{"name":"Delinquents","rank":60,"spoiler":true},{"name":"Kuudere","rank":60,"spoiler":false},{"name":"Vampire","rank":55,"spoiler":false},{"name":"CGI","rank":53,"spoiler":false},{"name":"Suicide","rank":53,"spoiler":true},{"name":"Time Manipulation","rank":20,"spoiler":true},{"name":"Prostitution","rank":20,"spoiler":true},{"name":"Ghost","rank":20,"spoiler":true}],"titles":{"display":"Demon Prince Enma","english":"Demon Prince Enma","native":"鬼公子炎魔","romaji":"Kikoushi Enma","synonyms":[]},"trailer":null,"visibility":"general"}