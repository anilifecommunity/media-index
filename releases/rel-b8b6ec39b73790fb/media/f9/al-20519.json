am of romance will never be fulfilled."},"tags":[{"name":"Coming of Age","rank":96,"spoiler":false},{"name":"Heterosexual","rank":85,"spoiler":false},{"name":"Female Protagonist","rank":84,"spoiler":false},{"name":"Food","rank":79,"spoiler":false},{"name":"School","rank":66,"spoiler":false},{"name":"Primarily Teen Cast","rank":63,"spoiler":false},{"name":"School Club","rank":60,"spoiler":false},{"name":"Animals","rank":40,"spoiler":false},{"name":"LGBTQ+ Themes","rank":40,"spoiler":true},{"name":"Love Triangle","rank":39,"spoiler":true},{"name":"Cute Girls Doing Cute Things","rank":35,"spoiler":false}],"titles":{"display":"Tamako -love story-","english":"Tamako -love story-","native":"たまこラブストーリー","romaji":"Tamako Love Story","synonyms":[{"language":"zh","source":"bangumi","value":"玉子爱情故事"},{"language":null,"source":"bangumi","value":"玉子恋爱物语"},{"language":null,"source":"bangumi","value":"玉子市场 剧场版"},{"language":null,"source":"bangumi","value":"玉子愛情故事"}]},"trailer":{"id":"H6eNSvvPRPo","site":"youtube","thumbnail":"https://i.ytimg.com/vi/H6eNSvvPRPo/hqdefault.jpg"},"visibility":"general"}