m/bx30044-vPmoz3vTPvZs.jpg","title":{"english":"Gin Tama","native":"銀魂","romaji":"Gintama","userPreferred":"Gintama"}},"relationType":"OTHER","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":87},"season":"SUMMER","seasonYear":2013,"series":["al-918","al-9969","al-15417","al-15335","al-20996","al-97889","al-99714","al-100784","al-101925","al-114129","al-126819"],"seriesIds":[918,9969,15417,15335,20996,97889,99714,100784,101925,114129,126819],"startDate":{"day":6,"month":7,"year":2013},"status":"FINISHED","studios":[{"animation":true,"id":14,"name":"Sunrise"},{"animation":false,"id":16,"name":"TV Tokyo"},{"animation":false,"id":17,"name":"Aniplex"},{"animation":false,"id":53,"name":"Dentsu"},{"animation":false,"id":230,"name":"Bandai"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"When Gintoki apprehends a movie pirate at a premiere, he checks the camera's footage and finds himself transported to a bleak, post-apocalyptic version of Edo, where a mysterious epidemic called the \"White Plague\" has ravished the world's population. It turns out that the movie pirate wasn't a pirate after all—it was an android time machine, and Gintoki has been hurtled five years into the future! Shinpachi and Kagura, his Yorozuya cohorts, have had a falling out and are now battle-hardened solo vigilantes and he himself has been missing for years, disappearing without a trace after scribbling a strange message in his journal.\n\nSetting out in the disguise given to him by the android time machine, Gintoki haphazardly reunites the Yorozuya team to investigate the White Plague, and soon discovers that the key to saving the future lies in the darkness of his own past. Determined to confront a powerful foe, he makes an important discovery—with a ragtag band of friends and allies at his side, he doesn't have to fight alone.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Time Manipulation","rank":93,"spoiler":true},{"name":"Tragedy","rank":88,"spoiler":true},{"name":"Male Protagonist","rank":83,"spoiler":false},{"name":"Swordplay","rank":80,"spoiler":false},{"name":"Post-Apocalyptic","rank":79,"spoiler":true},{"name":"Found Family","rank":79,"spoiler":false},{"name":"Samurai","rank":75,"spoiler":false},{"name":"Parody","rank":70,"spoiler":false},{"name":"Shounen","rank":70,"spoiler":false},{"name":"Historical","rank":68,"spoiler":false},{"name":"Primarily Adult Cast","rank":66,"spoiler":false},{"name":"Isekai","rank":32,"spoiler":false},{"name":"Kuudere","rank":20,"spoiler":false},{"name":"Guns","rank":10,"spoiler":false},{"name":"Rotoscoping","rank":10,"spoiler":false}],"titles":{"display":"Gintama: The Final Chapter - Be Forever Yorozuya","english":"Gintama: The Final Chapter - Be Forever Yorozuya","native":"劇場版 銀魂 完結篇 万事屋よ永遠なれ","romaji":"Gintama: Kanketsu-hen - Yorozuya yo Eien Nare","synonyms":[{"language":"zh","source":"bangumi","value":"银魂剧场版 完结篇 万事屋永不落"},{"language":null,"source":"bangumi","value":"银魂剧场版：完结篇 直到永远的万事屋"},{"language":null,"source":"bangumi","value":"银魂完结篇剧场版：永远的万事屋(港)"},{"language":null,"source":"bangumi","value":"Gintama: The Movie: The Final Chapter: Be Forever Yorozuya"},{"language":null,"source":"bangumi","value":"Gekijouban Gintama Kanketsuhen: Yorozuya yo Eien Nare"}]},"trailer":{"id":"UhJM5rVqaF8","site":"youtube","thumbnail":"https://i.ytimg.com/vi/UhJM5rVqaF8/hqdefault.jpg"},"visibility":"general"}