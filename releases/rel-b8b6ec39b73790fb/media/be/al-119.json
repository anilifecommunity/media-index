tcdn/media/anime/cover/medium/bx2104-8nyExxxIKd3P.jpg"},"duration":24,"episodes":26,"format":"TV","genres":["Comedy","Romance"],"id":2104,"idMal":2104,"isAdult":false,"popularity":63705,"season":"SPRING","seasonYear":2007,"startDate":{"day":2,"month":4,"year":2007},"status":"FINISHED","title":{"english":"My Bride is a Mermaid","native":"瀬戸の花嫁","romaji":"Seto no Hanayome","userPreferred":"Seto no Hanayome"}},"ids":{"anilist":2104},"mediaKey":"al-2104","resolved":true}],"relations":[],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":60},"season":"FALL","seasonYear":2004,"series":["al-119"],"seriesIds":[119],"startDate":{"day":3,"month":10,"year":2004},"status":"FINISHED","studios":[{"animation":false,"id":63,"name":"Trinet Entertainment"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Ever since their parents died a few years ago, Ryo and his sister Akane have been living alone together. Despite their difficult situation, they are still living reasonably happy and normal lives. However, everything is about to be flipped upside-down due to a secret government project. Due to increasingly low birth rates in Japan, the Japanese government is testing a program in which two young people are forced to marry. Ryo wants no part of it, but he is given little choice in the matter; his new fiancée, Shizuka, comes to his home late one night with several dozen government issued bodyguards, who are there to ensure the success of the new couple. Unlike Ryo, Shizuka couldn’t be more willing to go along with this new program, and eagerly goes about her wifely duties, despite his objections. With meddling friends, pushy bodyguards, and an overenthusiastic new fiancée, Ryo’s life has taken a turn in a direction the young man certainly didn’t expect.\n\n(Source: Anime News Network)"},"tags":[{"name":"Heterosexual","rank":79,"spoiler":false},{"name":"Orphan","rank":79,"spoiler":false},{"name":"Slapstick","rank":79,"spoiler":false},{"name":"M