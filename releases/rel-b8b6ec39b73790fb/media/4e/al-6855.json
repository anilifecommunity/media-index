riginal, fitting and memorable."},"tags":[{"name":"Classic Literature","rank":79,"spoiler":false},{"name":"Mythology","rank":79,"spoiler":false},{"name":"Super Power","rank":20,"spoiler":false}],"titles":{"display":"Uproar in Heaven","english":"Uproar in Heaven","native":"大闹天宫","romaji":"Danao Tiangong","synonyms":[{"language":null,"source":"bangumi","value":"Sun Ukun: Uproar in Heaven"},{"language":null,"source":"bangumi","value":"Da nao tien gong"},{"language":null,"source":"bangumi","value":"Havoc in Heaven"},{"language":null,"source":"bangumi","value":"The Monkey King"},{"language":null,"source":"bangumi","value":"大暴れ孫悟空"},{"language":null,"source":"bangumi","value":"大鬧天宮"}]},"trailer":null,"visibility":"general"}