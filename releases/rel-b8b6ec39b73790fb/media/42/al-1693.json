":100,"source":"anilist","value":62},"season":"WINTER","seasonYear":2007,"series":["al-1693"],"seriesIds":[1693],"startDate":{"day":4,"month":2,"year":2007},"status":"FINISHED","studios":[{"animation":true,"id":10,"name":"Production I.G"},{"animation":false,"id":33,"name":"WOWOW"},{"animation":false,"id":577,"name":"Tohokushinsha Film Corporation"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Saiga is a normal high school student with a gift in mathematics. His daily routine is disrupted when his family gets news that his Father's remains have been discovered—a noted archeologist and researcher who had gone missing while exploring a site many years before. Among his remains were notes and artifacts that needed to be identified by the family near a notable triangular mountain in Japan known as \"Japan's pyramid\", a place suspected by some to be man-made. A meteor containing a strange robotic lifeform falls from the sky and begins to cause destruction, putting Saiga in danger and causing a mysterious bracelet from his father's research to activate and merge him with an ancient robot burried within the pyramid—a robot the runes describe as Reideen. It is now up to Saiga and guardian Reideen to fight against this unknown alien threat from the sky.\n\n(Source: Anime News Network)"},"tags":[{"name":"Super Robot","rank":60,"spoiler":false},{"name":"Aliens","rank":50,"spoiler":false},{"name":"Military","rank":50,"spoiler":false},{"name":"Robots","rank":50,"spoiler":false}],"titles":{"display":"REIDEEN","english":null,"native":"REIDEEN","romaji":"REIDEEN","synonyms":[{"language":"zh","source":"bangumi","value":"新勇者莱汀"},{"language":null,"source":"bangumi","value":"新勇者莱丁"},{"language":null,"source":"bangumi","value":"ライディーン"}]},"trailer":{"id":"ojaYM9p9YI4","site":"youtube","thumbnail":"https://i.ytimg.com/vi/ojaYM9p9YI4/hqdefault.jpg"},"visibility":"general"}