 adventure begins for Honoka and Ikus.\n\n(Source: BestAnime, modified)"},"tags":[{"name":"Female Protagonist","rank":84,"spoiler":false},{"name":"Post-Apocalyptic","rank":79,"spoiler":false},{"name":"Swordplay","rank":79,"spoiler":false},{"name":"Tanks","rank":79,"spoiler":false},{"name":"Guns","rank":79,"spoiler":false},{"name":"Tragedy","rank":79,"spoiler":true},{"name":"Urban Fantasy","rank":73,"spoiler":false},{"name":"Lost Civilization","rank":70,"spoiler":false},{"name":"Robots","rank":70,"spoiler":false}],"titles":{"display":"The Third: The Girl with the Blue Eye","english":"The Third: The Girl with the Blue Eye","native":"ザ・サード 蒼い瞳の少女","romaji":"The Third: Aoi Hitomi no Shoujo","synonyms":[{"language":"ja","source":"bangumi","value":"ザ・サード 〜蒼い瞳の少女〜"},{"language":"zh","source":"bangumi","value":"苍之瞳的少女"},{"language":null,"source":"bangumi","value":"The Third"},{"language":null,"source":"bangumi","value":"ザ・サード"},{"language":null,"source":"bangumi","value":"苍瞳少女"}]},"trailer":null,"visibility":"general"}