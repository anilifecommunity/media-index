ythm: Dear My Future","node":{"countryOfOrigin":"JP","description":null,"episodes":51,"format":"TV","id":12863,"idMal":12863,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx12863-YerEY4cnzlfl.png","title":{"english":null,"native":"プリティーリズム・ディアマイフューチャー","romaji":"Pretty Rhythm: Dear My Future","userPreferred":"Pretty Rhythm: Dear My Future"}},"relationType":"CHARACTER","resolved":true},{"ids":{"anilist":17249,"mal":17249},"kind":"ANIME","mediaKey":"al-17249","name":"Pretty Rhythm: Rainbow Live","node":{"countryOfOrigin":"JP","description":null,"episodes":51,"format":"TV","id":17249,"idMal":17249,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx17249-FIqUTQWXkBWf.png","title":{"english":null,"native":"プリティーリズム・レインボーライブ","romaji":"Pretty Rhythm: Rainbow Live","userPreferred":"Pretty Rhythm: Rainbow Live"}},"relationType":"CHARACTER","resolved":true},{"ids":{"anilist":10257,"mal":10257},"kind":"ANIME","mediaKey":"al-10257","name":"Pretty Rhythm: Aurora Dream","node":{"countryOfOrigin":"JP","description":null,"episodes":51,"format":"TV","id":10257,"idMal":10257,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx10257-zwbhwbaZ7Zr1.jpg","title":{"english":null,"native":"プリティーリズム・オーロラドリーム","romaji":"Pretty Rhythm: Aurora Dream","userPreferred":"Pretty Rhythm: Aurora Dream"}},"relationType":"CHARACTER","resolved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":66},"season":"WINTER","seasonYear":2015,"series":["al-20917"],"seriesIds":[20917],"startDate":{"day":7,"month":3,"year":2015},"status":"FINISHED","studios":[{"animation":true,"id":103,"name":"Tatsunoko Production"},{"animation":false,"id":6429,"name":"Avex Pictures"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"PriPara Movie: Minna Atsumare! Prism☆Tours is the film based on and starring the characters from PriPara. The film first began showing in theaters across Japan from March 7th, 2015. The plot focuses on Laala Manaka finding out about Saints' top idol journey, and aside from the PriPara performances, the movie also features the journey of characters across all the Pretty Rhythm series.\n\nAt some point in the movie, the characters are given a choice of four doors to go through. At this point, the movie diverges into one of 4 routes depending on what the audience chooses. Each route recaps different aspects of the previous Pretty Rhythm series, mainly reintroducing the different characters and their performances. However, Laala and friends only get a chance to enter one door at a time, meaning the film must be watched four times to view each door choice.\n\n(Sources: PriPara Wikia and Wikipedia)"},"tags":[{"name":"Crossover","rank":79,"spoiler":false},{"name":"Cosmic Horror","rank":79,"spoiler":true},{"name":"Kids","rank":70,"spoiler":false},{"name":"Idol","rank":60,"spoiler":false},{"name":"Henshin","rank":60,"spoiler":false},{"name":"Female Protagonist","rank":60,"spoiler":false},{"name":"Primarily Female Cast","rank":60,"spoiler":false},{"name":"Magic","rank":50,"spoiler":false},{"name":"Fashion","rank":20,"spoiler":false},{"name":"Virtual World","rank":20,"spoiler":false}],"titles":{"display":"PriPara Movie: Minna Atsumare! Prism☆Tours","english":null,"native":"劇場版プリパラ　み～んなあつまれ！プリズム☆ツアーズ","romaji":"PriPara Movie: Minna Atsumare! Prism☆Tours","synonyms":[{"language":"zh","source":"bangumi","value":"美妙天堂剧场版 全～体大集合！美妙☆观光"},{"language":null,"source":"bangumi","value":"Gekijouban PuriPara: Minna Atsumare! Purizumu☆Tsuaazu"},{"language":null,"source":"bangumi","value":"PriPara the Movie: Everyone, Assemble! Prism☆Tours"}]},"trailer":{"id":"e3Ax1IIo74U","site":"youtube","thumbnail":"https://i.ytimg.com/vi/e3Ax1IIo74U/hqdefault.jpg"},"visibility":"general"}