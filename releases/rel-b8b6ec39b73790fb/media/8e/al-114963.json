tflix beginning on June 18."},"tags":[{"name":"Shapeshifting","rank":93,"spoiler":false},{"name":"Animals","rank":91,"spoiler":false},{"name":"Female Protagonist","rank":88,"spoiler":false},{"name":"Henshin","rank":83,"spoiler":false},{"name":"Kemonomimi","rank":80,"spoiler":false},{"name":"Family Life","rank":79,"spoiler":false},{"name":"Urban Fantasy","rank":79,"spoiler":false},{"name":"Heterosexual","rank":75,"spoiler":false},{"name":"Coming of Age","rank":70,"spoiler":false},{"name":"School","rank":67,"spoiler":false},{"name":"Anthropomorphism","rank":66,"spoiler":false},{"name":"Youkai","rank":60,"spoiler":false},{"name":"Bullying","rank":53,"spoiler":false},{"name":"Tragedy","rank":47,"spoiler":true},{"name":"Nekomimi","rank":46,"spoiler":false},{"name":"CGI","rank":41,"spoiler":false},{"name":"Rural","rank":38,"spoiler":false},{"name":"Feet","rank":20,"spoiler":false}],"titles":{"display":"A Whisker Away","english":"A Whisker Away","native":"泣きたい私は猫をかぶる","romaji":"Nakitai Watashi wa Neko wo Kaburu","synonyms":[{"language":"zh","source":"bangumi","value":"想哭的我戴上了猫的面具"},{"language":null,"source":"bangumi","value":"Nakitai Watashi wa Neko o Kaburu"},{"language":null,"source":"bangumi","value":"无限"}]},"trailer":{"id":"aXc9DVfLTGo","site":"youtube","thumbnail":"https://i.ytimg.com/vi/aXc9DVfLTGo/hqdefault.jpg"},"visibility":"general"}