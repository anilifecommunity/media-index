.\n\nSoon enough, the club's membership grows to four, as Oreki's friends Satoshi Fukube and Mayaka Ibara join. Driven by Chitanda's insatiable curiosity, the members of the Classics Club solve the trivial yet intriguing mysteries that permeate their daily lives.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"School Club","rank":95,"spoiler":false},{"name":"Detective","rank":93,"spoiler":false},{"name":"School","rank":89,"spoiler":false},{"name":"Primarily Teen Cast","rank":81,"spoiler":false},{"name":"Male Protagonist","rank":80,"spoiler":false},{"name":"Coming of Age","rank":73,"spoiler":false},{"name":"Episodic","rank":68,"spoiler":false},{"name":"Classic Literature","rank":68,"spoiler":false},{"name":"Bowling","rank":68,"spoiler":false},{"name":"Heterosexual","rank":61,"spoiler":false},{"name":"Rural","rank":58,"spoiler":false},{"name":"Filmmaking","rank":57,"spoiler":false},{"name":"Iyashikei","rank":56,"spoiler":false},{"name":"Otaku Culture","rank":45,"spoiler":false},{"name":"Politics","rank":40,"spoiler":true},{"name":"Shrine Maiden","rank":35,"spoiler":false},{"name":"Cosplay","rank":34,"spoiler":false},{"name":"Tsundere","rank":34,"spoiler":false}],"titles":{"display":"Hyouka","english":"Hyouka","native":"氷菓","romaji":"Hyouka","synonyms":[{"language":"zh","source":"bangumi","value":"冰菓"},{"language":null,"source":"bangumi","value":"冰果"}]},"trailer":{"id":"9nfs-qYVv0o","site":"youtube","thumbnail":"https://i.ytimg.com/vi/9nfs-qYVv0o/hqdefault.jpg"},"visibility":"general"}