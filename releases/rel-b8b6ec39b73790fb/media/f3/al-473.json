u.\n\n(Source: Anime News Network)"},"tags":[{"name":"Military","rank":79,"spoiler":false},{"name":"Post-Apocalyptic","rank":79,"spoiler":false},{"name":"Ships","rank":79,"spoiler":false}],"titles":{"display":"Tide-Line Blue","english":null,"native":"タイドライン・ブルー","romaji":"Tide-Line Blue","synonyms":[{"language":"zh","source":"bangumi","value":"蓝色潮痕"},{"language":null,"source":"bangumi","value":"Tide Line Blue"}]},"trailer":null,"visibility":"general"}