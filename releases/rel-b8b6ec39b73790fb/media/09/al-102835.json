"anilist":109896,"mal":118094},"kind":"MANGA","mediaKey":null,"name":"Revisions","node":{"countryOfOrigin":"JP","description":null,"episodes":null,"format":"MANGA","id":109896,"idMal":118094,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/b109896-9FogL5M2DhFQ.jpg","title":{"english":null,"native":"revisions リヴィジョンズ","romaji":"Revisions","userPreferred":"Revisions"}},"relationType":"ADAPTATION","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":57},"season":"WINTER","seasonYear":2019,"series":["al-102835"],"seriesIds":[102835],"startDate":{"day":9,"month":1,"year":2019},"status":"FINISHED","studios":[{"animation":true,"id":235,"name":"Shirogumi"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"\"This is a prediction. An extreme crisis will befall the five of you someday. At that time, you five will protect everyone.\" Daisuke Dōjima is a second-year high school student who, as a child, was kidnapped. Daisuke, along with his friends Gai, Lū, Marimari, and Keisaku, get wrapped up in the mysterious phenomenon known as the \"Shibuya Drift.\" The central area of Shibuya rises up and is transported at least 300 years in the \"future.\" What awaits them is a vast wasteland and forest dotted with ruins. There, they will work with the future people \"revisions\" to operate giant mechanical monsters. Daisuke meets a girl named Milo, who has the same name as the person who kidnapped Daisuke. Milo informs Daisuke that he's the only one who can operate the \"doll weapon String Puppet\" and protect Shibuya. Daisuke and his friends must take back the present by fighting the future in a town of isolation, against an unknown enemy.\n\n(Source: Anime News Network)"},"tags":[{"name":"Full CGI","rank":89,"spoiler":false},{"name":"Male Protagonist","rank":83,"spoiler":false},{"name":"Time Manipulation","rank":75,"spoiler":true},{"name":"Robots","rank":75,"spoiler":false},{"name":"Dystopian","rank":70,"spoiler":false},{"name":"Real Robot","rank":64,"spoiler":false},{"name":"Survival","rank":60,"spoiler":false},{"name":"Tragedy","rank":40,"spoiler":true}],"titles":{"display":"Revisions","english":null,"native":"リヴィジョンズ","romaji":"Revisions","synonyms":[{"language":"ja","source":"bangumi","value":"revisions リヴィジョンズ"},{"language":"zh","source":"bangumi","value":"涩谷保卫战"},{"language":null,"source":"bangumi","value":"新世纪涉谷战(港)"},{"language":null,"source":"bangumi","value":"涩谷新视界(台)"}]},"trailer":{"id":"07bswHElOjY","site":"youtube","thumbnail":"https://i.ytimg.com/vi/07bswHElOjY/hqdefault.jpg"},"visibility":"general"}