on uncovers bizarre truths and dark family secrets along the way.\n\n(Source: Anime News Network)"},"tags":[{"name":"Historical","rank":96,"spoiler":false},{"name":"Achronological Order","rank":86,"spoiler":false},{"name":"Ensemble Cast","rank":84,"spoiler":false},{"name":"Detective","rank":83,"spoiler":false},{"name":"Police","rank":80,"spoiler":false},{"name":"Primarily Adult Cast","rank":80,"spoiler":false},{"name":"Philosophy","rank":79,"spoiler":false},{"name":"Denpa","rank":66,"spoiler":true},{"name":"Rural","rank":60,"spoiler":false},{"name":"Body Horror","rank":60,"spoiler":true},{"name":"Youkai","rank":60,"spoiler":true},{"name":"Incest","rank":60,"spoiler":true}],"titles":{"display":"Mouryou no Hako","english":null,"native":"魍魎の匣","romaji":"Mouryou no Hako","synonyms":[{"language":"zh","source":"bangumi","value":"魍魉之匣"}]},"trailer":null,"visibility":"general"}