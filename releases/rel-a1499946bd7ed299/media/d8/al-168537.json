ijinsha"},{"animation":false,"id":323,"name":"Nippon Columbia"},{"animation":false,"id":7161,"name":"arma bianca"},{"animation":true,"id":6143,"name":"TYPHOON GRAPHICS"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Nozomu wants to be a writer, but for now she's just trying to find the right story. Walking home from school one day she bumps into some guys, and even though it's an accident, they hassle her until she is saved by a mysterious man. His name is Ichiyou, and he is searching for Gods. Nozomu sends him along his way only to be approached by Tenkou, who is searching for his Master. Nozomu reunites Ichiyou and Tenkou; (and their abusive relationship), and gets a view of another world. The two men are on a journey to find the Gods. The world that was once supported by four evil Gods, has fallen to a crisis. Using song and dance, it is up to the kashikans to bring back the Gods which fled from their confinement…"},"tags":[{"name":"Josei","rank":79,"spoiler":false},{"name":"Gods","rank":79,"spoiler":false},{"name":"Magic","rank":79,"spoiler":false},{"name":"Metal Music","rank":50,"spoiler":false},{"name":"Super Power","rank":20,"spoiler":false},{"name":"Male Protagonist","rank":20,"spoiler":false},{"name":"Achronological Order","rank":20,"spoiler":false},{"name":"Primarily Male Cast","rank":20,"spoiler":false}],"titles":{"display":"HAIGAKURA","english":"HAIGAKURA","native":"ハイガクラ","romaji":"Haigakura","synonyms":[{"language":"zh","source":"bangumi","value":"寻神的旅途"},{"language":null,"source":"bangumi","value":"稗记舞咏"},{"language":null,"source":"bangumi","value":"搜神物语"}]},"trailer":{"id":"P28z6xEWGuk","site":"youtube","thumbnail":"https://i.ytimg.com/vi/P28z6xEWGuk/hqdefault.jpg"},"visibility":"general"}