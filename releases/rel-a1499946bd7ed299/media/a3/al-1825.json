ons":[{"ids":{"anilist":1824,"mal":1824},"kind":"ANIME","mediaKey":"al-1824","name":"Hadashi no Gen","node":{"countryOfOrigin":"JP","description":null,"episodes":1,"format":"MOVIE","id":1824,"idMal":1824,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b1824-YN6bpoNBh0eK.jpg","title":{"english":"Barefoot Gen","native":"はだしのゲン","romaji":"Hadashi no Gen","userPreferred":"Hadashi no Gen"}},"relationType":"PREQUEL","resolved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":71},"season":"SUMMER","seasonYear":1986,"series":["al-1825","al-1824"],"seriesIds":[1825,1824],"startDate":{"day":14,"month":6,"year":1986},"status":"FINISHED","studios":[{"animation":true,"id":11,"name":"MADHOUSE"},{"animation":false,"id":189,"name":"GEN Productions"},{"animation":false,"id":467,"name":"Discotek"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Three years have passed since the bombing of Hiroshima and Gen is now a fourth-grader. Hiroshima is still a ruin, and Gen must scrounge for scrap metal to help keep himself and his remaining family fed, but at least commerce has returned to the land. As his mother gradually grows ill from radiation sickness, Gen and Ryuta befriend a group of orphans led by a tough-nosed older child and including a girl who still bears ugly burn scars from the day of the bomb. An old man suffering from depression is also drawn into the group as they come together to support each other and form a makeshift family. Reality is still harsh, however, as many orphans still die lonely deaths and the grim reminders of what happened linger everywhere.\n\n(Source: Anime News Network)"},"tags":[{"name":"Historical","rank":95,"spoiler":false},{"name":"Tragedy","rank":79,"spoiler":true},{"name":"Dystopian","rank":79,"spoiler":false},{"name":"Orphan","rank":79,"spoiler":true},{"name":"Found Family","rank":79,"spoiler":true},{"name":"Primarily Child Cast","rank":73,"spoiler":false},