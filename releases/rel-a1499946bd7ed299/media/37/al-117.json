: The first & last episode have a duration of ~46 minutes"},"tags":[{"name":"Isekai","rank":95,"spoiler":false},{"name":"Ensemble Cast","rank":79,"spoiler":false},{"name":"Super Power","rank":73,"spoiler":false},{"name":"Kaiju","rank":60,"spoiler":false},{"name":"Female Harem","rank":60,"spoiler":false},{"name":"Male Protagonist","rank":60,"spoiler":false},{"name":"Crossdressing","rank":60,"spoiler":false},{"name":"Royal Affairs","rank":60,"spoiler":false},{"name":"Nudity","rank":50,"spoiler":false},{"name":"LGBTQ+ Themes","rank":50,"spoiler":false},{"name":"Time Manipulation","rank":40,"spoiler":true}],"titles":{"display":"El Hazard: The Magnificent World","english":"El Hazard: The Magnificent World","native":"神秘の世界エルハザード","romaji":"Shinpi no Sekai El Hazard","synonyms":[{"language":"zh","source":"bangumi","value":"神秘的世界"},{"language":null,"source":"bangumi","value":"EL-HAZARD The Magnificent World"},{"language":null,"source":"bangumi","value":"El-Hazard: The Magnificent World"},{"language":null,"source":"bangumi","value":"神秘的世界 OVA"}]},"trailer":null,"visibility":"general"}