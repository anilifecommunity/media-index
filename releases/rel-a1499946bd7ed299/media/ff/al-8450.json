50"],"seriesIds":[8450],"startDate":{"day":16,"month":7,"year":1994},"status":"FINISHED","studios":[{"animation":false,"id":23,"name":"Bandai Visual"},{"animation":true,"id":386,"name":"Animaruya"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"The Biography of Budori Gusko was the recipient of numerous awards including the Monbusho Selection. The original novella on which the film is based is one of Kenji Miyazawa's more famous works, alongside Matasaburo the Wind Imp, Gauche the Cellist and Night on the Galactic Railroad. The story follows the life of a young boy named Gusuko who lives in the countryside with his parents and little sister. A string of droughts and other natural disasters tear the family apart, and Gusuko is forced to leave home and seek his fortunes on his own. Driven by a desire to improve the quality of life of his poor countrymen, he eventually joins a group of scientists called the Iihatov Volcano Department, and there takes part in scientific projects to fight the natural disasters that drove him from his home.\n\n(Source: pelleas.net)"},"tags":[{"name":"Classic Literature","rank":20,"spoiler":false},{"name":"Male Protagonist","rank":20,"spoiler":false}],"titles":{"display":"The Life of Guskou Budori","english":"The Life of Guskou Budori","native":"グスコーブドリの伝記","romaji":"Guskou Budori no Denki","synonyms":[{"language":"zh","source":"bangumi","value":"古斯柯布多力传记"},{"language":null,"source":"bangumi","value":"卜多力的一生"}]},"trailer":null,"visibility":"general"}