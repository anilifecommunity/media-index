":null,"episodes":null,"format":"MANGA","id":86717,"idMal":89087,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx86717-S7z7uizfTfEu.png","title":{"english":"Wotakoi: Love is Hard for Otaku","native":"ヲタクに恋は難しい","romaji":"Wotaku ni Koi wa Muzukashii","userPreferred":"Wotaku ni Koi wa Muzukashii"}},"relationType":"ADAPTATION","resolved":false},{"ids":{"anilist":104217,"mal":38349},"kind":"ANIME","mediaKey":"al-104217","name":"Wotaku ni Koi wa Muzukashii OVA","node":{"countryOfOrigin":"JP","description":null,"episodes":3,"format":"OVA","id":104217,"idMal":38349,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx104217-PoZOCoWD5ei8.jpg","title":{"english":null,"native":"ヲタクに恋は難しい OVA","romaji":"Wotaku ni Koi wa Muzukashii OVA","userPreferred":"Wotaku ni Koi wa Muzukashii OVA"}},"relationType":"SIDE_STORY","resolved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":78},"season":"SPRING","seasonYear":2018,"series":["al-99578"],"seriesIds":[99578],"startDate":{"day":13,"month":4,"year":2018},"status":"FINISHED","studios":[{"animation":true,"id":561,"name":"A-1 Pictures"},{"animation":false,"id":17,"name":"Aniplex"},{"animation":false,"id":169,"name":"Fuji TV"},{"animation":false,"id":6783,"name":"Kanetsuu Investment"},{"animation":false,"id":6812,"name":"Christmas Holly"},{"animation":false,"id":53,"name":"Dentsu"},{"animation":false,"id":6579,"name":"Ichijinsha"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Having slept through all four of her alarms, the energetic Narumi Momose finds herself running late for her first day of work at a new office. As she races to catch her train, she makes a promise to herself that none of her coworkers will find out about her dark secret: that she is an otaku and a fujoshi. Her plan goes instantly awry, though, when she runs into Hirotaka Nifuji, an old friend from middle school. Although she tries to keep her secret by inviting him out for drinks after work, her cover is blown when he casually asks her whether or not she will be attending the upcoming Summer Comiket. Luckily for her, the only witnesses—Hanako Koyanagi and Tarou Kabakura—are otaku as well.\n\nLater that night, the pair go out for drinks so that they can catch up after all the years apart. After Narumi complains about her previous boyfriend breaking up with her because he refused to date a fujoshi, Hirotaka suggests that she try dating a fellow otaku, specifically himself. He makes a solemn promise to always be there for her, to support her, and to help her farm for rare drops in Monster Hunter. Blown away by the proposal, Narumi agrees immediately. Thus the two otaku start dating, and their adorably awkward romance begins.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Otaku Culture","rank":99,"spoiler":false},{"name":"Primarily Adult Cast","rank":91,"spoiler":false},{"name":"Josei","rank":90,"spoiler":false},{"name":"Office Lady","rank":83,"spoiler":false},{"name":"Female Protagonist","rank":83,"spoiler":false},{"name":"Video Games","rank":80,"spoiler":false},{"name":"Work","rank":79,"spoiler":false},{"name":"Episodic","rank":78,"spoiler":false},{"name":"Male Protagonist","rank":77,"spoiler":false},{"name":"Office","rank":76,"spoiler":false},{"name":"Urban","rank":75,"spoiler":false},{"name":"Kuudere","rank":73,"spoiler":false},{"name":"Heterosexual","rank":73,"spoiler":false},{"name":"Ensemble Cast","rank":71,"spoiler":false},{"name":"Cosplay","rank":59,"spoiler":false},{"name":"Tsundere","rank":47,"spoiler":false},{"name":"Bisexual","rank":40,"spoiler":false},{"name":"Athletics","rank":35,"spoiler":true},{"name":"Tomboy","rank":30,"spoiler":false},{"name":"Classic Literature","rank":20,"spoiler":false}],"titles":{"display":"Wotakoi: Love is Hard for Otaku","english":"Wotakoi: Love is Hard for Otaku","native":"ヲタクに恋は難しい","romaji":"Wotaku ni Koi wa Muzukashii","synonyms":[{"language":"zh","source