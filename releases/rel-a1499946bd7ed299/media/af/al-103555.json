 ages and genders can enjoy!\n\n(Source: YTV, edited)"},"tags":[{"name":"Baseball","rank":90,"spoiler":false},{"name":"Shounen","rank":73,"spoiler":false},{"name":"School Club","rank":73,"spoiler":false},{"name":"Male Protagonist","rank":73,"spoiler":false},{"name":"Twins","rank":72,"spoiler":false},{"name":"School","rank":64,"spoiler":false},{"name":"Rural","rank":60,"spoiler":false},{"name":"Meta","rank":60,"spoiler":false},{"name":"Primarily Teen Cast","rank":60,"spoiler":false},{"name":"Primarily Male Cast","rank":55,"spoiler":false},{"name":"Bowling","rank":10,"spoiler":false}],"titles":{"display":"MIX","english":"MIX","native":"MIX MEISEI STORY","romaji":"MIX: MEISEI STORY","synonyms":[{"language":"zh","source":"bangumi","value":"MIX：明青故事"},{"language":null,"source":"bangumi","value":"MIX（ミックス）MEISEI STORY"}]},"trailer":null,"visibility":"general"}