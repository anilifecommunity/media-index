"startDate":{"day":1,"month":7,"year":2022},"status":"FINISHED","studios":[{"animation":true,"id":6074,"name":"C-Station"},{"animation":false,"id":6612,"name":"FuRyu"},{"animation":false,"id":213,"name":"Half H.P Studio"},{"animation":false,"id":963,"name":"MAGES."},{"animation":false,"id":6233,"name":"DeNA"},{"animation":false,"id":797,"name":"Houbunsha"},{"animation":false,"id":6818,"name":"81 Produce"},{"animation":false,"id":6758,"name":"Sony Music Solutions"},{"animation":false,"id":460,"name":"KLOCKWORX"},{"animation":false,"id":238,"name":"AT-X"},{"animation":false,"id":6616,"name":"BS11"},{"animation":false,"id":64,"name":"Sotsu"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Rin Shima has left her hometown in Yamanashi to live on her own in Nagoya while working for a small publishing company there. On one winter’s weekend in the not-too-distant future, as she’s planning a bike tour, she unexpectedly receives a message from an old high school friend, Chiaki Oogaki, saying she’s currently in Nagoya. Chiaki now works for an organization promoting tourism in Yamanashi, and she’s in charge of a project to reopen a facility that was closed a few years ago. When Rin casually suggests that such a large property would make a good campground, Chiaki is inspired. She gathers up all of their old camping buddies— Nadeshiko Kagamihara, who works at an outdoor goods store in Tokyo; Aoi Inuyama, who’s now an elementary school teacher in their hometown of Yamanashi; and Ena Saitou, who works at a dog grooming salon in Yokohama—and the campground-opening project is set in motion. So the story of five outdoorsy girls who became friends thanks to their shared love of camping begins once more, taking on a new challenge with the knowledge and experience they’ve gained.\n\n(Source: Crunchyroll, edited)"},"tags":[{"name":"Outdoor Activities","rank":96,"spoiler":false},{"name":"Primarily Adult Cast","rank":94,"spoiler":false},{"name":"Cute Girls Doing Cute Things","rank":90,"spoiler":false},{"name":"Camping","rank":90,"spoiler":false},{"name":"Iyashikei","rank":85,"spoiler":false},{"name":"Time Skip","rank":85,"spoiler":true},{"name":"Primarily Female Cast","rank":78,"spoiler":false},{"name":"Female Protagonist","rank":76,"spoiler":false},{"name":"Food","rank":73,"spoiler":false},{"name":"Coming of Age","rank":70,"spoiler":false},{"name":"Rural","rank":68,"spoiler":false},{"name":"Travel","rank":60,"spoiler":false},{"name":"Work","rank":57,"spoiler":true},{"name":"Mopeds","rank":42,"spoiler":false},{"name":"Seinen","rank":40,"spoiler":false},{"name":"Motorcycles","rank":37,"spoiler":false},{"name":"Animals","rank":33,"spoiler":true},{"name":"Robots","rank":26,"spoiler":false}],"titles":{"display":"Laid-Back Camp The Movie","english":"Laid-Back Camp The Movie","native":"映画 ゆるキャン△","romaji":"Yuru Camp△ Movie","synonyms":[{"language":"zh","source":"bangumi","value":"电影 摇曳露营△"},{"language":null,"source":"bangumi","value":"映画「ゆるキャン△」"},{"language":null,"source":"bangumi","value":"罗马字|Eiga Yuru Camp"},{"language":null,"source":"bangumi","value":"英文名1|Laid-Back Camp: Movie"},{"language":null,"source":"bangumi","value":"英文名2|Yuru Camp△: Movie"}]},"trailer":{"id":"DROz9ATilaw","site":"youtube","thumbnail":"https://i.ytimg.com/vi/DROz9ATilaw/hqdefault.jpg"},"visibility":"general"}