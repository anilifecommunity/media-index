 seem to get closer...\n\nA heartwarming workplace fantasy romcom starring a seemingly cool couple is about to begin!\n\n(Source: Crunchyroll)"},"tags":[{"name":"Office Lady","rank":90,"spoiler":false},{"name":"Heterosexual","rank":89,"spoiler":false},{"name":"Primarily Adult Cast","rank":88,"spoiler":false},{"name":"Iyashikei","rank":87,"spoiler":false},{"name":"Work","rank":86,"spoiler":false},{"name":"Youkai","rank":85,"spoiler":false},{"name":"Kuudere","rank":83,"spoiler":false},{"name":"Josei","rank":79,"spoiler":false},{"name":"Urban Fantasy","rank":79,"spoiler":false},{"name":"Interspecies","rank":79,"spoiler":false},{"name":"Super Power","rank":78,"spoiler":false},{"name":"Male Protagonist","rank":78,"spoiler":false},{"name":"Female Protagonist","rank":78,"spoiler":false},{"name":"Office","rank":77,"spoiler":false},{"name":"Kemonomimi","rank":67,"spoiler":false},{"name":"Episodic","rank":62,"spoiler":false},{"name":"Tsundere","rank":40,"spoiler":false},{"name":"Age Regression","rank":36,"spoiler":true},{"name":"Shrine Maiden","rank":31,"spoiler":true}],"titles":{"display":"The Ice Guy and His Cool Female Colleague","english":"The Ice Guy and His Cool Female Colleague","native":"氷属性男子とクールな同僚女子","romaji":"Koori Zokusei Danshi to Cool na Douryou Joshi","synonyms":[{"language":"zh","source":"bangumi","value":"冰属性男子与酷酷女同事"},{"language":null,"source":"bangumi","value":"冰属性男子与无表情女子"}]},"trailer":{"id":"pzyN6jakA3Q","site":"youtube","thumbnail":"https://i.ytimg.com/vi/pzyN6jakA3Q/hqdefault.jpg"},"visibility":"general"}