iler":false},{"name":"Surreal Comedy","rank":80,"spoiler":false},{"name":"School Club","rank":79,"spoiler":false},{"name":"Primarily Child Cast","rank":68,"spoiler":false},{"name":"Shounen","rank":66,"spoiler":false},{"name":"School","rank":36,"spoiler":false}],"titles":{"display":"Yu-Gi-Oh! SEVENS","english":"Yu-Gi-Oh! SEVENS","native":"遊☆戯☆王SEVENS","romaji":"Yu☆Gi☆Oh! SEVENS","synonyms":[{"language":"zh","source":"bangumi","value":"游戏王 七星"},{"language":null,"source":"bangumi","value":"游戏王SEVENS"},{"language":null,"source":"bangumi","value":"Yu-Gi-Oh Sevens"}]},"trailer":{"id":"WTQ_PWj8zw4","site":"youtube","thumbnail":"https://i.ytimg.com/vi/WTQ_PWj8zw4/hqdefault.jpg"},"visibility":"general"}