ghtStuf)"},"tags":[{"name":"Shounen","rank":90,"spoiler":false},{"name":"Monster Girl","rank":90,"spoiler":false},{"name":"Female Harem","rank":80,"spoiler":false},{"name":"Vampire","rank":79,"spoiler":false},{"name":"Robots","rank":79,"spoiler":false},{"name":"Kemonomimi","rank":79,"spoiler":false},{"name":"Kuudere","rank":79,"spoiler":false},{"name":"Tomboy","rank":79,"spoiler":false},{"name":"Maids","rank":75,"spoiler":false},{"name":"Dullahan","rank":70,"spoiler":false},{"name":"Ojou-sama","rank":66,"spoiler":false},{"name":"Werewolf","rank":60,"spoiler":false},{"name":"Zombie","rank":60,"spoiler":true},{"name":"Primarily Female Cast","rank":60,"spoiler":false},{"name":"Necromancy","rank":60,"spoiler":false},{"name":"Heterosexual","rank":60,"spoiler":false},{"name":"Witch","rank":60,"spoiler":false},{"name":"Motorcycles","rank":50,"spoiler":false}],"titles":{"display":"Princess Resurrection","english":"Princess Resurrection","native":"怪物王女","romaji":"Kaibutsu Oujo","synonyms":[{"language":null,"source":"bangumi","value":"Kaibutsu Oujyo"}]},"trailer":{"id":"qs9D0NFiplE","site":"youtube","thumbnail":"https://i.ytimg.com/vi/qs9D0NFiplE/hqdefault.jpg"},"visibility":"general"}