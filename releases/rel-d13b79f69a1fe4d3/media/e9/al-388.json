 Japan Junior Cart. Looking at their chase, Naomi’s mother, Minamoto Nanako, advised Capeta to take part in the official race.\n\n(Source: Anime News Network)"},"tags":[{"name":"Cars","rank":100,"spoiler":false},{"name":"Shounen","rank":79,"spoiler":false},{"name":"Coming of Age","rank":79,"spoiler":false},{"name":"Primarily Child Cast","rank":79,"spoiler":false},{"name":"Male Protagonist","rank":60,"spoiler":false},{"name":"Time Skip","rank":53,"spoiler":true},{"name":"CGI","rank":40,"spoiler":false},{"name":"Idol","rank":20,"spoiler":false},{"name":"School","rank":20,"spoiler":false},{"name":"Work","rank":20,"spoiler":false}],"titles":{"display":"capeta","english":null,"native":"capeta","romaji":"capeta","synonyms":[{"language":"zh","source":"bangumi","value":"极速方程式"},{"language":null,"source":"bangumi","value":"カペタ"}]},"trailer":null,"visibility":"general"}