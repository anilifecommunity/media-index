s://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx84281-ym91NHdznBtg.png","title":{"english":null,"native":"ZOIDS ゾイドSS","romaji":"Zoids SS","userPreferred":"Zoids SS"}},"relationType":"ADAPTATION","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":70},"season":"FALL","seasonYear":1999,"series":["al-763"],"seriesIds":[763],"startDate":{"day":4,"month":9,"year":1999},"status":"FINISHED","studios":[{"animation":true,"id":27,"name":"Xebec"},{"animation":false,"id":31,"name":"NBCUniversal Entertainment Japan"},{"animation":false,"id":119,"name":"Viz Media"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Zoids are beast-like fighting machines used in both everyday use such as transportation, and special use such as war. Some types of Zoids, know as Organoids, are miniature Zoids that are living organisms. These Organoids have the capability to fuse with a non-living Zoid and make it much more powerful.\n\nVan (Ban) Freiheit discovers a Zoid Organoid in an abandoned laboratory while running from two strangers piloting Zoids. Also in the laboratory, in an animated suspension tube is a strange girl. He breaks the tube open and takes her and the Organoid with him. Spotting a ruined Shield Liger Zoid outside nearby, the Organoid fuses with it and repairs the damages. Making his escape, Van names the Organoid Zeke, and decides to keep him as a friend. The girl, who says her name is Fiona, wants to find something called Zoids Eve, and so Van, Zeke, and Fiona begin their adventure.\n\n(Source: AniDB)"},"tags":[{"name":"Robots","rank":79,"spoiler":false},{"name":"CGI","rank":60,"spoiler":false},{"name":"War","rank":60,"spoiler":false},{"name":"Male Protagonist","rank":40,"spoiler":false},{"name":"Super Robot","rank":40,"spoiler":false},{"name":"Real Robot","rank":40,"spoiler":false}],"titles":{"display":"Zoids","english":"Zoids","native":"ゾイド","romaji":"Zoids","synonyms":[{"language":"ja","source":"bangum