thly Shōnen Ace, Newtype, Dengeki Hobby Magazine, and Figure Oh. The Petit Eva project has also developed merchandising from super-deformed figurines to limited edition Doritos corn chips.\"\n\n(Source: MoonPhase)"},"tags":[{"name":"Full CGI","rank":98,"spoiler":false},{"name":"No Dialogue","rank":97,"spoiler":false},{"name":"Parody","rank":93,"spoiler":false},{"name":"Chibi","rank":91,"spoiler":false},{"name":"Episodic","rank":80,"spoiler":false},{"name":"School","rank":76,"spoiler":false},{"name":"Primarily Teen Cast","rank":70,"spoiler":false},{"name":"CGI","rank":64,"spoiler":false},{"name":"Ensemble Cast","rank":60,"spoiler":false},{"name":"Angels","rank":60,"spoiler":false},{"name":"Urban","rank":60,"spoiler":false},{"name":"Surreal Comedy","rank":60,"spoiler":false},{"name":"Robots","rank":50,"spoiler":false},{"name":"Aliens","rank":20,"spoiler":false},{"name":"Tsundere","rank":20,"spoiler":false}],"titles":{"display":"Petit Eva: Evangelion@School","english":null,"native":"ぷちえゔぁ","romaji":"Petit Eva: Evangelion@School","synonyms":[{"language":"zh","source":"bangumi","value":"EVA爆笑学园"},{"language":null,"source":"bangumi","value":"ぷちえう゛ぁ"},{"language":null,"source":"bangumi","value":"Q版EVA"},{"language":null,"source":"bangumi","value":"福音小战士"},{"language":null,"source":"bangumi","value":"新世纪福音战士原创网络动画：爆笑学园"},{"language":null,"source":"bangumi","value":"新世纪福音战士ONA：爆笑学园"},{"language":null,"source":"bangumi","value":"Puchi Eva: Evangelion@School"},{"language":null,"source":"bangumi","value":"ぷちえゔぁ〜EVANGELION@SCHOOL〜"}]},"trailer":null,"visibility":"general"}