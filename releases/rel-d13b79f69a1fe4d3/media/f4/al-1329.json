":false},{"name":"Foreign","rank":79,"spoiler":false},{"name":"Fugitive","rank":79,"spoiler":false},{"name":"Tragedy","rank":79,"spoiler":true},{"name":"War","rank":79,"spoiler":false},{"name":"Family Life","rank":60,"spoiler":false},{"name":"Language Barrier","rank":60,"spoiler":false}],"titles":{"display":"Rail of the Star: A True Story of Children","english":"Rail of the Star: A True Story of Children","native":"お星さまのレール","romaji":"O-Hoshisama no Rail","synonyms":[{"language":"zh","source":"bangumi","value":"星星的轨迹"},{"language":null,"source":"bangumi","value":"Rail of the Star"}]},"trailer":null,"visibility":"general"}