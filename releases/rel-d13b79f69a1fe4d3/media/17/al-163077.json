rld.\n\n(Source: Crunchyroll)"},"tags":[{"name":"Virtual World","rank":88,"spoiler":false},{"name":"Video Games","rank":84,"spoiler":false},{"name":"Isekai","rank":63,"spoiler":false},{"name":"Artificial Intelligence","rank":60,"spoiler":true},{"name":"Travel","rank":50,"spoiler":false},{"name":"Seinen","rank":40,"spoiler":false},{"name":"Work","rank":40,"spoiler":false},{"name":"Dissociative Identities","rank":40,"spoiler":true},{"name":"Time Loop","rank":40,"spoiler":true},{"name":"Meta","rank":30,"spoiler":false},{"name":"Dragons","rank":20,"spoiler":false},{"name":"Dungeon","rank":20,"spoiler":false},{"name":"Gore","rank":20,"spoiler":false},{"name":"Disability","rank":20,"spoiler":false},{"name":"Elf","rank":20,"spoiler":false},{"name":"Primarily Adult Cast","rank":20,"spoiler":false},{"name":"Bullying","rank":20,"spoiler":true},{"name":"Software Development","rank":20,"spoiler":false},{"name":"Archery","rank":10,"spoiler":false}],"titles":{"display":"Quality Assurance in Another World","english":"Quality Assurance in Another World","native":"この世界は不完全すぎる","romaji":"Kono Sekai wa Fukanzen Sugiru","synonyms":[{"language":"zh","source":"bangumi","value":"这个世界漏洞百出"}]},"trailer":{"id":"zRBgezLwtdE","site":"youtube","thumbnail":"https://i.ytimg.com/vi/zRBgezLwtdE/hqdefault.jpg"},"visibility":"general"}