lved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":71},"season":"FALL","seasonYear":2016,"series":["al-21496"],"seriesIds":[21496],"startDate":{"day":14,"month":10,"year":2016},"status":"FINISHED","studios":[{"animation":true,"id":486,"name":"Digital Frontier"},{"animation":false,"id":6869,"name":"KYORAKU"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Death does not have to be the end; one can live again, but only through beating the game posed by the black ball called Gantz.\n\nOn his way home to celebrate his younger brother's birthday, brave and kind-hearted student named Masaru Katou is stabbed to death. He awakes in a small room with a cityscape view in the heart of Tokyo—and he is not alone. To his surprise, it is not the afterlife, but the waiting room for a high stakes game with their lives on the line. Before he has the chance to process the situation, Masaru is handed a gun and teleported into the center of Osaka to carry out one simple task: eliminate any alien on sight.\n\nAccompanied by the aged Yoshikazu Suzuki, the stunning idol Reika Shimohira, and the cold but experienced Jouichirou Nishi, Masaru must overcome his fears in order to survive the game and return home to his waiting brother.\n\n(Source: MAL Rewrite)\n\nNote: A full 3DCG movie adaptation of the manga's Osaka arc."},"tags":[{"name":"Survival","rank":96,"spoiler":false},{"name":"Full CGI","rank":89,"spoiler":false},{"name":"Aliens","rank":88,"spoiler":false},{"name":"Death Game","rank":86,"spoiler":false},{"name":"Guns","rank":85,"spoiler":false},{"name":"Cyberpunk","rank":80,"spoiler":false},{"name":"Tragedy","rank":79,"spoiler":true},{"name":"Urban","rank":79,"spoiler":false},{"name":"Cosmic Horror","rank":79,"spoiler":false},{"name":"Youkai","rank":79,"spoiler":false},{"name":"CGI","rank":79,"spoiler":false},{"name":"Gore","rank":76,"spoiler":false},{"name":"Seinen","rank":76,"spoiler":false},{"name":"Male Protagonist","rank":