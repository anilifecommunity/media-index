dMal":61851,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx194447-sgmaOpJ0VIUI.jpg","title":{"english":"Isekai Quartet 3","native":"異世界かるてっと 3","romaji":"Isekai Quartet 3","userPreferred":"Isekai Quartet 3"}},"relationType":"CHARACTER","resolved":true}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":73},"season":"FALL","seasonYear":2019,"series":["al-105156"],"seriesIds":[105156],"startDate":{"day":2,"month":10,"year":2019},"status":"FINISHED","studios":[{"animation":true,"id":314,"name":"WHITE FOX"},{"animation":false,"id":102,"name":"Funimation"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"There is a popular saying: \"you can never be too careful.\" It is very important to prepare for every situation you may face, even if it seems like an unnecessary waste of time. Also, in games like RPGs, it is good to exceed the level of your enemies to achieve total victory.\n\nThese words describe Seiya Ryuuguuin a little too perfectly. After being summoned by the goddess Ristarte to save the world of Gaeabrande from destruction, the hero prepares himself for his noble journey. While this might be normal, he spends a very long time training himself, despite having overpowered stats. He fights weak enemies using his strongest skills and buys excessive amounts of supplies and potions—all to stay safe.\n\nWhile his attitude may be a bit annoying, it might just be the saving grace of Gaeabrande, especially considering that it is a world where the forces of evil dominate each and every expectation.\n\n(Source: MAL Rewrite)"},"tags":[{"name":"Isekai","rank":97,"spoiler":false},{"name":"Parody","rank":91,"spoiler":false},{"name":"Magic","rank":89,"spoiler":false},{"name":"Cultivation","rank":83,"spoiler":false},{"name":"Gods","rank":82,"spoiler":false},{"name":"Tragedy","rank":81,"spoiler":true},{"name":"Female Protagonist","rank":80,"spoiler":false},{"name":"Reincarnation","rank":79,"sp