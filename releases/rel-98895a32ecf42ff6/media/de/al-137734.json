 and premiere dates in China, where it aired earlier than it did in Japan."},"tags":[{"name":"Primarily Teen Cast","rank":80,"spoiler":false},{"name":"Episodic","rank":75,"spoiler":false},{"name":"Family Life","rank":66,"spoiler":false},{"name":"Slapstick","rank":65,"spoiler":false},{"name":"Bisexual","rank":60,"spoiler":false},{"name":"School","rank":50,"spoiler":false},{"name":"Female Protagonist","rank":20,"spoiler":false},{"name":"Male Protagonist","rank":20,"spoiler":false},{"name":"Basketball","rank":20,"spoiler":false}],"titles":{"display":"Ani ni Tsukeru Kusuri wa Nai! 5","english":null,"native":"兄に付ける薬はない！5","romaji":"Ani ni Tsukeru Kusuri wa Nai! 5","synonyms":[{"language":"ja","source":"bangumi","value":"快把我哥带走5"},{"language":null,"source":"bangumi","value":"快把我哥带走 第五季"}]},"trailer":{"id":"ZrY-5siiy1g","site":"youtube","thumbnail":"https://i.ytimg.com/vi/ZrY-5siiy1g/hqdefault.jpg"},"visibility":"general"}