s://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx81733-946GxhOINndg.png","title":{"english":null,"native":"つり球","romaji":"Tsuritama","userPreferred":"Tsuritama"}},"relationType":"ADAPTATION","resolved":false},{"ids":{"anilist":81737,"mal":51737},"kind":"MANGA","mediaKey":null,"name":"Tsuritama SF -Short Films-","node":{"countryOfOrigin":"JP","description":null,"episodes":null,"format":"NOVEL","id":81737,"idMal":51737,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/b81737-3m6bbqVrnGJA.jpg","title":{"english":null,"native":"つり球 SF -Short Films-","romaji":"Tsuritama SF -Short Films-","userPreferred":"Tsuritama SF -Short Films-"}},"relationType":"SIDE_STORY","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":73},"season":"SPRING","seasonYear":2012,"series":["al-12883"],"seriesIds":[12883],"startDate":{"day":13,"month":4,"year":2012},"status":"FINISHED","studios":[{"animation":false,"id":17,"name":"Aniplex"},{"animation":false,"id":53,"name":"Dentsu"},{"animation":true,"id":561,"name":"A-1 Pictures"},{"animation":false,"id":169,"name":"Fuji TV"},{"animation":false,"id":376,"name":"Sentai Filmworks"},{"animation":false,"id":653,"name":"tsuritama partners"},{"animation":true,"id":765,"name":"Sakura Create"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"You can't catch fish if you don't go fishing, and you can't make friends if you don't at least try.\n\nWhich is how relationship-challenged student Yuki finds himself on a fishing trip to a tiny island with three other boys he barely knows. Well, two other boys and Haru, who claims that he's an alien. Not that constantly stewing Natsuki or mysterious Akira are any more likely as prospects for good companionship.\n\nBut there's something about fishing that makes it unlike any other pastime, and maybe that quiet sense of companionship and hopeful expectation is just what Yuki needs to start charting the unfamiliar waters of personal connections.  Or maybe it will turn out that Haru's right and they're going to have to save the entire planet.\n\nThere are lots of different kinds of fish stories, from the \"ones that got away\" to the \"best catches ever,\" but whichever way the currents of life take them, for four young men, this trip may turn out to be the biggest whopper ever!\n\n(Source: Sentai Filmworks)"},"tags":[{"name":"Fishing","rank":94,"spoiler":false},{"name":"Coming of Age","rank":90,"spoiler":false},{"name":"Aliens","rank":83,"spoiler":false},{"name":"Male Protagonist","rank":80,"spoiler":false},{"name":"Cute Boys Doing Cute Things","rank":80,"spoiler":false},{"name":"Tanned Skin","rank":79,"spoiler":false},{"name":"Primarily Teen Cast","rank":79,"spoiler":false},{"name":"Family Life","rank":79,"spoiler":false},{"name":"Coastal","rank":79,"spoiler":false},{"name":"Shapeshifting","rank":75,"spoiler":true},{"name":"Memory Manipulation","rank":75,"spoiler":false},{"name":"Primarily Male Cast","rank":74,"spoiler":false},{"name":"Fugitive","rank":70,"spoiler":true},{"name":"Outdoor Activities","rank":63,"spoiler":false},{"name":"Dancing","rank":50,"spoiler":false},{"name":"School","rank":50,"spoiler":false}],"titles":{"display":"Tsuritama","english":"Tsuritama","native":"つり球","romaji":"Tsuritama","synonyms":[{"language":"zh","source":"bangumi","value":"钓球"}]},"trailer":{"id":"CQBw_XrZWkw","site":"youtube","thumbnail":"https://i.ytimg.com/vi/CQBw_XrZWkw/hqdefault.jpg"},"visibility":"general"}