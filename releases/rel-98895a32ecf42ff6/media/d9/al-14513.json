s"},{"animation":false,"id":143,"name":"Mainichi Broadcasting System"},{"animation":false,"id":493,"name":"Aniplex of America"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"This story is about the flow of fate and the battle to keep the world on the right path. Aladdin is a boy who has set out to explore the world after being trapped in a room for most of his life. His best friend is a flute with a djinn in it named Ugo. Soon enough, Aladdin discovers he is a Magi, a magician who chooses kings, and he was born to choose kings who will follow the righteous path, battling against those who want to destroy fate. Follow his adventures as he meets others from 1001 Arabian Nights, like Ali Baba and Sinbad, and fights to keep the balance of the world in check!"},"tags":[{"name":"Magic","rank":95,"spoiler":false},{"name":"Tragedy","rank":90,"spoiler":true},{"name":"Shounen","rank":89,"spoiler":false},{"name":"Male Protagonist","rank":88,"spoiler":false},{"name":"Politics","rank":83,"spoiler":false},{"name":"Dungeon","rank":80,"spoiler":false},{"name":"War","rank":80,"spoiler":true},{"name":"Travel","rank":80,"spoiler":false},{"name":"Desert","rank":80,"spoiler":false},{"name":"Royal Affairs","rank":79,"spoiler":false},{"name":"Middle East","rank":79,"spoiler":false},{"name":"Kingdom Management","rank":73,"spoiler":true},{"name":"Foreign","rank":70,"spoiler":false},{"name":"Slavery","rank":70,"spoiler":false},{"name":"Primarily Male Cast","rank":66,"spoiler":false},{"name":"Swordplay","rank":64,"spoiler":false},{"name":"Economics","rank":57,"spoiler":false},{"name":"Nudity","rank":43,"spoiler":false},{"name":"Tanned Skin","rank":36,"spoiler":false}],"titles":{"display":"Magi: The Labyrinth of Magic","english":"Magi: The Labyrinth of Magic","native":"マギ The labyrinth of magic","romaji":"Magi: The labyrinth of magic","synonyms":[{"language":"zh","source":"bangumi","value":"天方魔谭MAGI"},{"language":null,"source":"bangumi","value":"MAGI"},{"language":nul