crophone and considers the place to be her own personal sanctuary. But as she moves further away from her comfort zone and the ideas people have of her, she discovers that letting others into her world of death metal may not be such a bad thing."},"tags":[{"name":"Work","rank":95,"spoiler":false},{"name":"Office Lady","rank":93,"spoiler":false},{"name":"Metal Music","rank":93,"spoiler":false},{"name":"Anthropomorphism","rank":92,"spoiler":false},{"name":"Primarily Adult Cast","rank":90,"spoiler":false},{"name":"Urban","rank":88,"spoiler":false},{"name":"Female Protagonist","rank":87,"spoiler":false},{"name":"Office","rank":84,"spoiler":false},{"name":"Animals","rank":81,"spoiler":false},{"name":"Chibi","rank":76,"spoiler":false},{"name":"Primarily Animal Cast","rank":70,"spoiler":false},{"name":"Flash","rank":62,"spoiler":false},{"name":"Unrequited Love","rank":60,"spoiler":false},{"name":"Rock Music","rank":25,"spoiler":false}],"titles":{"display":"Aggretsuko","english":"Aggretsuko","native":"アグレッシブ烈子","romaji":"Aggressive Retsuko","synonyms":[{"language":"zh","source":"bangumi","value":"职场小烈"},{"language":null,"source":"bangumi","value":"冲吧烈子"},{"language":null,"source":"bangumi","value":"爆发吧烈子"},{"language":null,"source":"bangumi","value":"Aggressive烈子"},{"language":null,"source":"bangumi","value":"zh_TW|衝吧烈子"},{"language":null,"source":"bangumi","value":"en|Aggretsuko"}]},"trailer":{"id":"1n3xXuEyr40","site":"youtube","thumbnail":"https://i.ytimg.com/vi/1n3xXuEyr40/hqdefault.jpg"},"visibility":"general"}