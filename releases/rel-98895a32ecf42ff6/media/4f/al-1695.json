37,"mal":55301},"kind":"MANGA","mediaKey":null,"name":"Les Misérables","node":{"countryOfOrigin":"JP","description":null,"episodes":null,"format":"MANGA","id":87937,"idMal":55301,"isAdult":false,"poster":"https://s4.anilist.co/file/anilistcdn/media/manga/cover/medium/bx87937-9X1uc9yq5u01.png","title":{"english":"LES MISÉRABLES","native":"LES MISERABLES レ・ミゼラブル","romaji":"Les Misérables","userPreferred":"Les Misérables"}},"relationType":"ALTERNATIVE","resolved":false}],"schemaVersion":"1.1.0","score":{"scale":100,"source":"anilist","value":78},"season":"WINTER","seasonYear":2007,"series":["al-1695"],"seriesIds":[1695],"startDate":{"day":7,"month":1,"year":2007},"status":"FINISHED","studios":[{"animation":true,"id":22,"name":"Nippon Animation"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Based on the famous classic novel Les Miserables.\n\nBeing a single mother is hard in early 19th Century France. When young Cosette was traveling with her mother trying to find a job and a place to live, they were always shunned away because very few employers hire single mothers. When she is promised with the prosperity of working in the big city, Cosette is separated from her mother in the hopes a caretaker will watch over her while her mother earns some money. Unfortunately this was a trick and the caretaker is a corrupt man who makes Cosette his indentured servant. Then the kind mayor of the town that Cosette makes her new home in sees how winds of change are so detrimental for children and families, and decides to do something about it.\n\n(Source: Anime News Network)"},"tags":[{"name":"Historical","rank":95,"spoiler":false},{"name":"Classic Literature","rank":94,"spoiler":false},{"name":"Coming of Age","rank":88,"spoiler":true},{"name":"Female Protagonist","rank":84,"spoiler":false},{"name":"Foreign","rank":82,"spoiler":false},{"name":"Bullying","rank":80,"spoiler":false},{"name":"Tragedy","rank":80,"spoiler":true},{"name":"Heterosexual","rank":79,"sp