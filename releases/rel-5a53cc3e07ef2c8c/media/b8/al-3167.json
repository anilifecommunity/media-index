ysterious café that features a house rule that \"humans and robots are to be treated the same\"...\n\n(Source: Official Website - English)"},"tags":[{"name":"Robots","rank":94,"spoiler":false},{"name":"Artificial Intelligence","rank":92,"spoiler":false},{"name":"Philosophy","rank":84,"spoiler":false},{"name":"Bar","rank":80,"spoiler":false},{"name":"Male Protagonist","rank":79,"spoiler":false},{"name":"Urban","rank":60,"spoiler":false},{"name":"Amnesia","rank":50,"spoiler":true},{"name":"Surreal Comedy","rank":40,"spoiler":false},{"name":"CGI","rank":20,"spoiler":false},{"name":"Found Family","rank":20,"spoiler":true},{"name":"Female Protagonist","rank":20,"spoiler":false}],"titles":{"display":"Time of Eve","english":"Time of Eve","native":"イヴの時間 Are you enjoying the time of EVE ?","romaji":"Eve no Jikan: Are you enjoying the time of EVE?","synonyms":[{"language":"ja","source":"bangumi","value":"イヴの時間"},{"language":"zh","source":"bangumi","value":"夏娃的时间"}]},"trailer":{"id":"Xru2rINDuXE","site":"youtube","thumbnail":"https://i.ytimg.com/vi/Xru2rINDuXE/hqdefault.jpg"},"visibility":"general"}