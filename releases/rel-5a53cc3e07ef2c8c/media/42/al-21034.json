","rank":60,"spoiler":false},{"name":"Kuudere","rank":43,"spoiler":false},{"name":"Episodic","rank":40,"spoiler":false},{"name":"Guns","rank":20,"spoiler":true}],"titles":{"display":"Is the Order a Rabbit?? Season 2","english":"Is the Order a Rabbit?? Season 2","native":"ご注文はうさぎですか？？","romaji":"Gochuumon wa Usagi desu ka??","synonyms":[{"language":"zh","source":"bangumi","value":"请问您今天要来点兔子吗？？"},{"language":null,"source":"bangumi","value":"Gochuumon wa Usagi Desuka??"},{"language":null,"source":"bangumi","value":"Is the Order a Rabbit??"},{"language":null,"source":"bangumi","value":"请问您今天要来点兔子吗？ 第二季"},{"language":null,"source":"bangumi","value":"请问您点的是兔子吗？？"}]},"trailer":{"id":"awfptUKbWEo","site":"youtube","thumbnail":"https://i.ytimg.com/vi/awfptUKbWEo/hqdefault.jpg"},"visibility":"general"}