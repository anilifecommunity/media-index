s":["al-20047"],"seriesIds":[20047],"startDate":{"day":10,"month":1,"year":2014},"status":"FINISHED","studios":[{"animation":true,"id":37,"name":"Studio DEEN"},{"animation":false,"id":145,"name":"TBS"},{"animation":false,"id":376,"name":"Sentai Filmworks"},{"animation":false,"id":6548,"name":"Hanabee Entertainment"}],"synopsis":{"language":null,"source":"anilist","spoiler":false,"text":"Haruka and Yuu have been best friends forever and they've always sat next to each other in class since… well, since they were just girls in junior high anyway. But on their first day of high school, they're stunned to learn that the new seating plan has them on opposite sides of the classroom! So, since everyone knows that long distance relationships won't work unless the parties involved put extra effort into it, they decide they need to do something extra special to permanently seal their friendship. However, deciding to kiss each other awakens a whole new level of feelings, and it doesn't help that some of their classmates seem to be 'involved\" in similar circumstances. So what's a girl to do when her best girl friend suddenly seems more like a girlfriend? It's a life lesson that the school curriculum isn't normally prepared to teach, except maybe in French class, and our two young heroines are about to get a private education you'll never forget!\n\n(Source: Sentai Filmworks)"},"tags":[{"name":"Yuri","rank":98,"spoiler":false},{"name":"Primarily Female Cast","rank":92,"spoiler":false},{"name":"Cute Girls Doing Cute Things","rank":91,"spoiler":false},{"name":"Female Protagonist","rank":90,"spoiler":false},{"name":"Primarily Teen Cast","rank":90,"spoiler":false},{"name":"LGBTQ+ Themes","rank":90,"spoiler":false},{"name":"School","rank":87,"spoiler":false},{"name":"Love Triangle","rank":69,"spoiler":false},{"name":"Coming of Age","rank":60,"spoiler":false},{"name":"Seinen","rank":57,"spoiler":false},{"name":"Kuudere","rank":55,"spoiler":false}],"titles":{"display":"Sakura Trick","e