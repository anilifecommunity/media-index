tile army.\n\n(Source: Official Website)"},"tags":[{"name":"Super Robot","rank":79,"spoiler":false},{"name":"Super Power","rank":79,"spoiler":false},{"name":"Aliens","rank":79,"spoiler":false}],"titles":{"display":"Balatack","english":"Balatack","native":"超人戦隊バラタック","romaji":"Choujin Sentai Baratack","synonyms":[{"language":"zh","source":"bangumi","value":"超人战队Barattack"},{"language":null,"source":"bangumi","value":"无敌巴拉达"}]},"trailer":null,"visibility":"general"}