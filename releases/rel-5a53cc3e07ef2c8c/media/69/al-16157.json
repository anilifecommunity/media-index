 of piracy, an anonymous master hacker, and an evil CPU hell-bent on destroying everything in her path – using any cheat code necessary!\n\n(Source: Funimation)"},"tags":[{"name":"Video Games","rank":91,"spoiler":false},{"name":"Female Protagonist","rank":84,"spoiler":false},{"name":"Primarily Female Cast","rank":82,"spoiler":false},{"name":"Henshin","rank":80,"spoiler":false},{"name":"Cute Girls Doing Cute Things","rank":79,"spoiler":false},{"name":"Parody","rank":77,"spoiler":false},{"name":"Gods","rank":76,"spoiler":true},{"name":"Meta","rank":65,"spoiler":false},{"name":"Kuudere","rank":60,"spoiler":false},{"name":"Memory Manipulation","rank":50,"spoiler":true},{"name":"Alternate Universe","rank":50,"spoiler":true},{"name":"Time Skip","rank":20,"spoiler":true}],"titles":{"display":"Hyperdimension Neptunia","english":"Hyperdimension Neptunia","native":"超次元ゲイム ネプテューヌ THE ANIMATION","romaji":"Choujigen Game Neptune THE ANIMATION","synonyms":[{"language":"zh","source":"bangumi","value":"超次元游戏 海王星"},{"language":null,"source":"bangumi","value":"超次元战记 战机少女"},{"language":null,"source":"bangumi","value":"Hyperdimension Neptunia: The Animation"}]},"trailer":{"id":"QUBDyCqOFso","site":"youtube","thumbnail":"https://i.ytimg.com/vi/QUBDyCqOFso/hqdefault.jpg"},"visibility":"general"}