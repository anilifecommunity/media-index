iend. Dangerously tangled in the past, Okabe must face the harsh reality and carefully maneuver around the disastrous consequences that come with disturbing the natural flow of time."},"tags":[{"name":"Alternate Universe","rank":96,"spoiler":true},{"name":"War","rank":96,"spoiler":true},{"name":"Time Manipulation","rank":92,"spoiler":true},{"name":"Artificial Intelligence","rank":91,"spoiler":false},{"name":"Tragedy","rank":89,"spoiler":true},{"name":"Dystopian","rank":85,"spoiler":true},{"name":"Post-Apocalyptic","rank":79,"spoiler":true},{"name":"Dissociative Identities","rank":79,"spoiler":false},{"name":"Urban","rank":78,"spoiler":false},{"name":"Age Regression","rank":77,"spoiler":true},{"name":"Time Skip","rank":76,"spoiler":true},{"name":"Philosophy","rank":75,"spoiler":false},{"name":"Amnesia","rank":72,"spoiler":true},{"name":"Male Protagonist","rank":71,"spoiler":false},{"name":"Seinen","rank":66,"spoiler":false},{"name":"Kuudere","rank":60,"spoiler":false},{"name":"Memory Manipulation","rank":60,"spoiler":true},{"name":"Military","rank":60,"spoiler":false},{"name":"Disability","rank":60,"spoiler":false},{"name":"Primarily Adult Cast","rank":60,"spoiler":false},{"name":"Femboy","rank":60,"spoiler":false},{"name":"College","rank":57,"spoiler":false},{"name":"Fugitive","rank":56,"spoiler":true},{"name":"Chuunibyou","rank":53,"spoiler":true},{"name":"Otaku Culture","rank":52,"spoiler":false},{"name":"Shrine Maiden","rank":43,"spoiler":false},{"name":"Gore","rank":40,"spoiler":true},{"name":"Brainwashing","rank":20,"spoiler":true}],"titles":{"display":"Steins;Gate 0","english":"Steins;Gate 0","native":"シュタインズ・ゲート ゼロ","romaji":"Steins;Gate 0","synonyms":[{"language":"zh","source":"bangumi","value":"命运石之门 0"},{"language":null,"source":"bangumi","value":"石头门 0"}]},"trailer":{"id":"IVVihb4-cHo","site":"youtube","thumbnail":"https://i.ytimg.com/vi/IVVihb4-cHo/hqdefault.jpg"},"visibility":"general"}