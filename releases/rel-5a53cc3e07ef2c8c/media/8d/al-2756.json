e","rank":60,"spoiler":true},{"name":"Reincarnation","rank":50,"spoiler":true},{"name":"Rural","rank":50,"spoiler":false}],"titles":{"display":"Yobi, The Five Tailed Fox","english":"Yobi, The Five Tailed Fox","native":"천년여우 여우비","romaji":"Cheonnyeon-yeowoo Yeowoobi","synonyms":[{"language":"zh","source":"bangumi","value":"千年狐"},{"language":null,"source":"bangumi","value":"Yobi The Five Tailed Fox"},{"language":null,"source":"bangumi","value":"五尾狐"}]},"trailer":null,"visibility":"general"}