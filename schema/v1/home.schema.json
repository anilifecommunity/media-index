{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/anilifecommunity/media-index/main/schema/v1/home.schema.json",
  "title": "Anilife home rows v1",
  "description": "Precomputed snapshot rows for a cold client. Ranks are snapshots, not live provider trends.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "rows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "rows": {
      "type": "object",
      "required": ["spotlight", "trending", "popular", "topRated", "season", "newest", "upcoming", "movies"],
      "additionalProperties": false,
      "properties": {
        "spotlight": { "type": "array", "items": { "$ref": "compact-row.schema.json" } },
        "trending": { "type": "array", "items": { "$ref": "compact-row.schema.json" } },
        "popular": { "type": "array", "items": { "$ref": "compact-row.schema.json" } },
        "topRated": { "type": "array", "items": { "$ref": "compact-row.schema.json" } },
        "season": { "type": "array", "items": { "$ref": "compact-row.schema.json" } },
        "newest": { "type": "array", "items": { "$ref": "compact-row.schema.json" } },
        "upcoming": { "type": "array", "items": { "$ref": "compact-row.schema.json" } },
        "movies": { "type": "array", "items": { "$ref": "compact-row.schema.json" } }
      }
    }
  }
}
