{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/anilifecommunity/media-index/main/schema/v1/bucket-manifest.schema.json",
  "title": "Anilife bucket manifest v1",
  "description": "Per-file integrity inventory for one hash bucket of media or episode records.",
  "type": "object",
  "required": ["schemaVersion", "bucket", "files"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "bucket": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "path", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^al-[1-9][0-9]*$" },
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
