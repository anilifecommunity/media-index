{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/anilifecommunity/media-index/main/schema/v2/alias-ledger.schema.json",
  "title": "Anilife append-only identity bindings v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "bindings"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "bindings": {"type": "array", "maxItems": 100000, "items": {"oneOf": [{"$ref": "#/$defs/externalBinding"}, {"$ref": "#/$defs/sourceBinding"}]}},
    "unresolvedAliases": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/unresolvedAlias"}}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false, "required": ["kind", "mediaKey"],
      "properties": {"kind": {"$ref": "media-ref.schema.json#/properties/kind"}, "mediaKey": {"$ref": "media-ref.schema.json#/properties/mediaKey"}}
    },
    "externalBinding": {
      "type": "object", "additionalProperties": false, "required": ["alias", "target"],
      "properties": {"alias": {"allOf": [{"$ref": "media-ref.schema.json#/$defs/alias"}, {"properties": {"verified": {"const": true}}}]}, "target": {"$ref": "#/$defs/target"}}
    },
    "sourceBinding": {
      "type": "object", "additionalProperties": false, "required": ["sourceRef", "verified", "target"],
      "properties": {"sourceRef": {"$ref": "media-ref.schema.json#/$defs/sourceRef"}, "verified": {"const": true}, "target": {"$ref": "#/$defs/target"}}
    },
    "unresolvedAlias": {
      "type": "object", "additionalProperties": false, "required": ["alias", "reason", "candidates"],
      "properties": {
        "alias": {"allOf": [{"$ref": "media-ref.schema.json#/$defs/alias"}, {"properties": {"verified": {"const": false}}}]},
        "reason": {"enum": ["ambiguous", "changed", "unverified"]},
        "candidates": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}}
      }
    }
  }
}
